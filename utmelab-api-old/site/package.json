{
  "name": "utmelab-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces && node scripts/merge.mjs",
    "dev:web": "npm run dev --workspace @utmelab/web",
    "dev:docs": "npm run dev --workspace @utmelab/docs",
    "dev:app": "npm run dev --workspace @utmelab/app",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
