[Unit]
Description=UTME Lab Question Bank API (utmelab-api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=utmelab
Group=utmelab

# Secrets + runtime config live here, 0640 root:utmelab. CI never touches it.
# Per D73 there is no data dir and no keys file: Turso is the only source and
# no JSON is embedded or shipped.
#   UTMELAB_API_BIND=127.0.0.1:8081
#   UTMELAB_API_REPORTS_FILE=/var/lib/utmelab-api/reports.json
#   UTMELAB_BANK_CACHE_FILE=/var/lib/utmelab-api/bank_cache.json
#   UTMELAB_BANK_REFRESH_SECS=300
#   TURSO_DB_URL=turso://...
#   TURSO_DB_TOKEN=...        (write token — server only, never in site/ or CI)
#   KEY_CACHE_TTL_SECS=30
EnvironmentFile=/etc/utmelab-api/environment

WorkingDirectory=/opt/apps/utmelab-api/current
ExecStart=/opt/apps/utmelab-api/current/utmelab-api serve
Restart=on-failure
RestartSec=3

# The API must write its operational files (keys/reports when file-backed) and
# read data/ + site/. Everything else stays read-only.
ReadWritePaths=/var/lib/utmelab-api

# Hardening (matches the parent utmelab.service; systemd-analyze security ~3.x).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
