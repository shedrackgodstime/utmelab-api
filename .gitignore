tagging_results.json
tagging_*.json

# Runtime logs & scratch outputs (beyond the harvest backup)
tmp/*.log
tmp/serve.log

# OS / editor leftovers
.DS_Store
Thumbs.db
*.swp
.*.swp
.*.swo
.*.un~
*.db-shm
*.db-wal


