#!/usr/bin/env bash
# utmelab-api-deploy - the ONE privileged deploy step (mirrors the parent
# UTME-Lab `utmelab-deploy` gate).
#
# The `deploy` user may run exactly this script via NOPASSWD sudo and nothing
# else. It activates a release that CI already extracted into
# /opt/apps/utmelab-api/releases/<v>. It never builds, never fetches, never
# edits config - config lives in /etc/utmelab-api/environment (systemd reads it).
#
# A release is:
#   releases/<v>/utmelab-api        the Rust binary (executable)
#   releases/<v>/site/              the built static site (index.html + openapi.json)
#
# Activation = atomically re-point the `current` symlink, restart the service,
# poll /ready.
#
# There is NO fallback. If a release fails its readiness check the deploy stops
# there and exits non-zero; you fix the code and ship the next release. Nothing
# is auto-rolled-back and no old version is kept as insurance.
#
# On success every release except the active one is deleted, so the VPS carries
# one prerelease at a time. Revisit that once v0.1.0 lands and there is a real
# release history worth keeping.
set -euo pipefail

APP=utmelab-api
BASE=/opt/apps/utmelab-api
REL="$BASE/releases"
CUR="$BASE/current"
SVC=utmelab-api.service
# Keep in step with API_PORT in .github/workflows/deploy.yml and PORT in
# /etc/utmelab-api/environment. The gate runs as root and does not load the env
# file, so it cannot read the value from there.
# 3100, not 8081: the binary binds config.rs DEFAULT_PORT = 3100. A gate that
# polls 8081 finds nothing, and if its failure test is weak it will happily
# "pass" a service that never bound and then prune the last good release.
PORT=3100
READY="http://127.0.0.1:${PORT}/ready"

log() { printf '[utmelab-api-deploy] %s\n' "$*"; }
die() { printf '[utmelab-api-deploy] ERROR: %s\n' "$*" >&2; exit "${2:-1}"; }

V="${1:-}"
# Strict semver only. Rejects "../../etc/passwd", "v1; rm", empty, etc.
[[ "$V" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.]+)?$ ]] \
  || die "invalid version '$V' (expected vMAJOR.MINOR.PATCH[-pre])" 2

SRC="$REL/$V"
[[ -d "$SRC" ]] || die "release '$V' does not exist under $REL" 3
[[ -x "$SRC/$APP" ]] || die "release '$V' has no executable $APP" 4
[[ -f "$SRC/site/index.html" ]] || die "release '$V' has no site/index.html (site build missing)" 5
# The docs reference and the Postman/Insomnia download both resolve to this
# file, so a release without it would serve a broken /openapi.json. Refuse it
# here rather than at the edge.
[[ -f "$SRC/site/openapi.json" ]] || die "release '$V' has no site/openapi.json (spec not shipped)" 5

# Make the release readable/executable by the runtime user (service runs as
# utmelab, a system user with no login). releases/ is deploy-owned; the service
# reads via the "others" bits.
chmod -R o+rX "$SRC" 2>/dev/null || true
chmod 0755 "$SRC/$APP" 2>/dev/null || true

# Keep the active release and delete the rest. A release is a ~30 MB binary plus
# the static site, so a month of prereleases would eat the disk. Called ONLY
# after a healthy activation, so a failed deploy can never delete anything.
# Default 0 = the VPS carries exactly one release. Raise with
# UTMELAB_API_KEEP_RELEASES=N when real releases land and history is worth
# keeping (e.g. 3 keeps the active one plus the two before it).
prune() {
  local keep="${UTMELAB_API_KEEP_RELEASES:-0}" d n=0
  [[ "$keep" =~ ^[0-9]+$ ]] || keep=0
  while IFS= read -r d; do
    [[ "$d" == "$SRC" ]] && continue   # never delete what we just activated
    n=$((n + 1))
    (( n > keep )) || continue
    rm -rf -- "$d"
    log "pruned ${d##*/}"
  done < <(find "$REL" -mindepth 1 -maxdepth 1 -type d -name 'v*' | sort)
}

log "activating $V"
ln -sfn "$SRC" "$CUR"

restart_and_wait() {
  systemctl restart "$SVC"
  # Poll /ready, not /health: readiness is the signal that the replica is open
  # and its schema contract is trusted, so the data surfaces will actually
  # answer. /health only says the process can reply at all. A binary that binds
  # but 500s, or a boot that crash-loops, must fail the deploy.
  #
  # Budget 180 s (60 x 3), not 30 s. /ready answers 503 until the replica is
  # open, and on a host with no replica that means a FULL first sync, which is
  # slower than the incremental pulls every later restart does. At 30 s the gate
  # failed a boot that was perfectly healthy, and because the gate runs before
  # the edge smoke — which waits 180 s — the smoke never got to prove it. The
  # gate must not be the impatient one. 180 s also matches the deploy's own
  # smoke budget, so the two cannot disagree about patience.
  for _ in $(seq 1 60); do
    # `|| true`, NOT `|| echo 000`: on a connection failure curl prints its own
    # 000 *and* exits non-zero, so `|| echo 000` captures "000000", which is
    # != "000" — an earlier version of this gate read that as healthy, pruned
    # the previous release, and reported success on a service that never bound.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$READY" 2>/dev/null || true)"
    [[ "$code" == "200" ]] && { log "ready OK (HTTP $code)"; return 0; }
    sleep 3
  done
  log "not ready after 180 s (last HTTP ${code:-none})"
  return 1
}

if restart_and_wait; then
  log "release $V is live"
  prune
  exit 0
fi

# Activation failed. No fallback by policy: dump the diagnosis and stop.
# `current` still points at $V (the service is down or unhealthy) and nothing
# was pruned, so the next deploy still has room to land. Fix and re-ship.
log "activation FAILED - $V did not answer $READY"
systemctl status "$SVC" --no-pager -l >&2 || true
journalctl -u "$SVC" -n 40 --no-pager >&2 || true
die "release $V failed readiness check; not serving - fix and deploy again" 7
