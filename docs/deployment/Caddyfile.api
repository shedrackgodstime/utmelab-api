# Caddy site for the API + grouped docs (D32: Caddy path-routes).
# Install as /etc/caddy/Caddyfile.api and `import` it, or merge into the main
# Caddyfile. Requires DNS api.utmelab.com -> this host, then Caddy gets a real
# Let's Encrypt cert automatically (no `tls internal`).
#
# Routing:
#   /api/*  /health  /openapi.json  -> the Rust binary on 127.0.0.1:8081
#   everything else                  -> the static docs built from site/ (dist)
# The binary never serves HTML; Caddy serves the docs and proxies the API.
#
# RENAMED: this directory was `web/` until 2026-10-12 and is now `site/`. The
# built site ships in the release as release/site and is served from
# /opt/apps/utmelab-api/current/site. An already-provisioned host still has the
# old Caddyfile and gate installed under the old name — re-run
# `bash docs/deployment/vps-onetime-setup.sh` on the VPS before the next deploy,
# otherwise the gate rejects the release and this root 404s.

api.utmelab.com {
	encode gzip zstd

	# API first, in explicit handle blocks. These cannot be reordered by
	# accident: in Caddy's default directive order `file_server` runs BEFORE
	# `reverse_proxy`, so a bare matcher + reverse_proxy would lose every
	# request to the try_files fallback below and /health would answer with
	# the docs homepage. handle blocks are sequential and make that explicit.
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /health {
		reverse_proxy 127.0.0.1:8081
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8081
	}

	# Static docs tier (Astro build output ships as site/ in the release).
	handle {
		root * /opt/apps/utmelab-api/current/site
		try_files {path} /index.html
		file_server
	}
}
