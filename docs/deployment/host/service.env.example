# One service, one file:  /etc/deploy-service/<service>.env   (0600 root:root)
#
# This is the only file a human edits, and the only place a service is named.
# `system provision <service>` derives everything else from it:
#   systemd instance        utmelab@<service>, plus a drop-in for User/Group
#                           and ReadWritePaths
#   Caddy site block        /etc/caddy/sites/<service>.caddy
#   release tree            /opt/apps/<service>/releases
#   writable state dir(s)   READ_WRITE_PATHS
#
# One thing is deliberately NOT per service: the CI identity that stages a
# release and calls the gate. It is the single `deploy` user on this host, with
# one key, reused by every service's repository. Adding a service is therefore
# one manifest and one provision, never another login account, key and GitHub
# secret pair.
#
# It is read twice: by systemd as the service's EnvironmentFile, and by the
# deploy gate as root. Because systemd reads it as PID 1 the file stays 0600
# root:root, and the service's own user never reads its secrets off disk.
#
# Adding a service is: copy this file, fill it in, then
#   system provision <name>
#   system verify
# The host-level pieces are already in place: the CI key is enrolled once
# (`system enroll <ci-public-key>`) and VPS_USER/VPS_SSH_KEY are the same values
# in every service repo.

# --- identity ---------------------------------------------------------------
# SERVICE_NAME and BINARY_NAME default to the file name. RUNTIME_USER defaults to
# <service>: the process user, created on provision, owning READ_WRITE_PATHS.
SERVICE_NAME=myapp
BINARY_NAME=myapp
RUNTIME_USER=myapp

# --- routing ----------------------------------------------------------------
# DOMAIN is the Caddy site address. Leave it out for a loopback-only service.
DOMAIN=myapp.example.com
IP=127.0.0.1
PORT=9000

# --- what "live" means ------------------------------------------------------
# The gate refuses to activate a release until HEALTH_ENDPOINT answers exactly
# HEALTH_EXPECT. Ask for the honest signal, not the cheap one: a process can
# bind its port long before it can serve, which is what /ready exists to say.
HEALTH_ENDPOINT=/ready
HEALTH_EXPECT=200
HEALTH_TRIES=60
HEALTH_DELAY=3
# The release must ship this file; it is the static tier Caddy serves for DOMAIN.
ASSET_PATH=public/index.html

# --- housekeeping -----------------------------------------------------------
# Superseded releases kept for rollback (`system rollback <service>`).
KEEP_RELEASES=3
# State directories the service may write. Created, owned by RUNTIME_USER, and
# handed to systemd as ReadWritePaths. Space separated.
READ_WRITE_PATHS=/var/lib/myapp

# --- the service's own environment -----------------------------------------
# Everything the process needs to boot, so there is one place to rotate.
TURSO_DB_URL=
TURSO_DB_TOKEN=
