#!/usr/bin/env bash
# system — the one admin tool for every service on this host.
#
#   sudo system provision <service>       create/repair everything derived from
#                                         that service's manifest
#   sudo system enroll <service> <key>    register a CI public key for the
#                                         service's deploy identity
#   sudo system verify                    check every service against its manifest
#   sudo system report                    resource + service health
#   sudo system deploy preview            what a deploy would do (read-only)
#   sudo system rollback <service>        flip back to the previous release
#   sudo system service list|show <svc>   the manifests on this host
#   sudo system root status|on|off        root SSH posture
#   system help
#
# The source of truth is one file per service:
#   /etc/deploy-service/<service>.env     (0600 root:root, holds the secrets)
# Everything below is generated from it and never hand-edited:
#   /etc/systemd/system/utmelab@<service>.service.d/override.conf
#   /etc/caddy/sites/<service>.caddy      (written once, then yours to edit)
#   /etc/sudoers.d/deploy-<service>
#   /opt/apps/<service>/releases, READ_WRITE_PATHS, the two users
#
# Rehearsal: SYSTEM_PREFIX=/tmp/box relocates every path this tool touches.
set -uo pipefail

P="${SYSTEM_PREFIX:-}"
CONFIG_DIR="${P}/etc/deploy-service"
BASE_DIR="${P}/opt/apps"
CADDY_DIR="${P}/etc/caddy"
CADDY_FILE="${CADDY_DIR}/Caddyfile"
SITE_DIR="${CADDY_DIR}/sites"
SUDOERS_DIR="${P}/etc/sudoers.d"
UNIT_DIR="${P}/etc/systemd/system"
DEPLOY_GATE="/usr/local/bin/deploy-service"

if [ -t 1 ]; then B=$(tput bold) D=$(tput sgr0) C=$(tput setaf 4) G=$(tput setaf 2) Y=$(tput setaf 3) R=$(tput setaf 1); else B=""; D=""; C=""; G=""; Y=""; R=""; fi

ISSUES=0
WARNINGS=0

die() { printf '%serror:%s %s\n' "$R" "$D" "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$*"; }
hr() { printf '%s%s%s\n' "$C" "------------------------------------------------------------" "$D"; }
ok() { printf '  %s ok %s %s\n' "$G" "$D" "$*"; }
warn() { WARNINGS=$((WARNINGS + 1)); printf '  %swarn%s %s\n' "$Y" "$D" "$*"; }
bad() { ISSUES=$((ISSUES + 1)); printf '  %sFAIL%s %s\n' "$R" "$D" "$*"; }

ORIG=("$@")
need_root() {
  [ "$(id -u)" -eq 0 ] && return 0
  exec sudo "$0" "${ORIG[@]}"
}

# --- reading the source of truth --------------------------------------------
list_services() {
  local f
  for f in "${CONFIG_DIR}"/*.env; do [ -f "$f" ] || continue; basename "$f" .env; done
}

manifest() { printf '%s/%s.env' "${CONFIG_DIR}" "$1"; }

# value of a key, empty when absent
env_of() { awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$(manifest "$1")" 2>/dev/null; }

# value of a key, or the fallback when absent/empty
env_or() { local v; v="$(env_of "$1" "$2")"; printf '%s' "${v:-$3}"; }

unit_active() { systemctl is-active --quiet "utmelab@$1" 2>/dev/null; }
unit_state() { systemctl is-active "utmelab@$1" 2>/dev/null || true; }
unit_enabled() { systemctl is-enabled "utmelab@$1" 2>/dev/null || true; }
health_url() { printf 'http://%s:%s%s' "$(env_or "$1" IP 127.0.0.1)" "$(env_or "$1" HEALTH_PORT "$(env_of "$1" PORT)")" "$(env_or "$1" HEALTH_ENDPOINT /)"; }
http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time "${2:-10}" "$1" 2>/dev/null || printf '000'; }

# ============================================================================
# provision — materialise everything a manifest implies
# ============================================================================
install_user() { # name, login(optional)
  local name="$1" login="${2:-}"
  id -u "$name" >/dev/null 2>&1 && return 0
  if [ -n "$login" ]; then
    useradd --create-home --shell /bin/bash "$name" || die "could not create user $name"
  else
    useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin "$name" || die "could not create user $name"
  fi
  say "  created user ${name}"
}

ensure_dir() { # path, mode, owner
  mkdir -p "$1" || die "mkdir -p $1"
  chmod "$2" "$1" || die "chmod $2 $1"
  chown "$3" "$1" || die "chown $3 $1"
}

write_dropin() { # svc, runtime, rw
  local svc="$1" runtime="$2" rw="$3" dd="${UNIT_DIR}/utmelab@$1.service.d"
  mkdir -p "$dd" || die "mkdir $dd"
  {
    printf '# Generated by `system provision %s`. Do not edit: change the manifest\n' "$svc"
    printf '# %s and re-run provision.\n\n' "$(manifest "$svc")"
    printf '[Service]\n'
    printf 'User=%s\nGroup=%s\n' "$runtime" "$runtime"
    # Must stay an if, not `[ -n "$rw" ] && printf`: a false test would be the
    # group's exit status, the redirect would still have written the file, and
    # provision would abort for every service with no writable path.
    if [ -n "$rw" ]; then printf 'ReadWritePaths=%s\n' "$rw"; fi
  } >"${dd}/override.conf" || die "writing ${dd}/override.conf"
  say "  unit drop-in: ${dd}/override.conf (User=${runtime})"
}

write_site() { # svc, domain, ip, port
  local svc="$1" domain="$2" ip="$3" port="$4" f="${SITE_DIR}/${svc}.caddy"
  if [ -z "$domain" ]; then
    say "  no DOMAIN in manifest: loopback-only, no Caddy site"
    return 0
  fi
  mkdir -p "$SITE_DIR" || die "mkdir $SITE_DIR"
  if [ -f "$f" ]; then
    say "  site file exists, left untouched: $f"
    return 0
  fi
  {
    printf '# Written once by `system provision %s` from %s.\n' "$svc" "$(manifest "$svc")"
    printf '# This file is never rewritten: add custom routing here freely.\n\n'
    printf '%s {\n' "$domain"
    printf '\tencode gzip zstd\n'
    printf '\treverse_proxy %s:%s\n' "$ip" "$port"
    printf '}\n'
  } >"$f" || die "writing $f"
  say "  site file created: $f ($domain -> $ip:$port)"
  CREATED_SITE=1
}

write_sudoers() { # deploy_user, svc
  local user="$1" svc="$2" f="${SUDOERS_DIR}/deploy-${svc}"
  mkdir -p "$SUDOERS_DIR"
  {
    printf '# Generated by `system provision %s`.\n' "$svc"
    printf '# The CI identity for this service, scoped to the shared gate. The gate\n'
    printf '# re-checks the caller name itself, so this identity cannot activate a\n'
    printf '# neighbouring service even though the script is shared.\n'
    printf '%s ALL=(root) NOPASSWD: %s\n' "$user" "$DEPLOY_GATE"
  } >"$f" || die "writing $f"
  chown root:root "$f"; chmod 0440 "$f"
  visudo -cf "$f" >/dev/null 2>&1 || die "sudoers rejected $f"
  say "  sudoers: $f (${user} may run ${DEPLOY_GATE})"
}

reload_caddy() {
  command -v caddy >/dev/null 2>&1 || { warn "caddy not installed: site files are inert"; return 0; }
  caddy validate --config "$CADDY_FILE" --adapter caddyfile >/dev/null 2>&1 \
    || { bad "caddy rejected $CADDY_FILE: nothing reloaded"; return 0; }
  systemctl reload caddy 2>/dev/null || systemctl restart caddy 2>/dev/null || true
  say "  caddy reloaded"
}

cmd_provision() {
  need_root
  local svc="${1:-}"
  [ -n "$svc" ] || die "usage: system provision <service>"
  [[ "$svc" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid service name: $svc"
  local man; man="$(manifest "$svc")"
  [ -f "$man" ] || die "no manifest at $man"

  local runtime deploy_user domain ip port rw
  runtime="$(env_or "$svc" RUNTIME_USER "$svc")"
  deploy_user="$(env_or "$svc" DEPLOY_USER "deploy-$svc")"
  domain="$(env_of "$svc" DOMAIN)"
  ip="$(env_or "$svc" IP 127.0.0.1)"
  port="$(env_of "$svc" PORT)"
  rw="$(env_of "$svc" READ_WRITE_PATHS)"

  [ -n "$port" ] || die "$man has no PORT"
  [[ "$runtime" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "bad RUNTIME_USER: $runtime"
  [[ "$deploy_user" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "bad DEPLOY_USER: $deploy_user"

  printf '%sPROVISION %s%s\n' "$B" "$svc" "$D"
  hr

  # The manifest carries secrets, so it is never group- or world-readable.
  # systemd reads it as root, which is why 0600 is enough.
  chown root:root "$man"; chmod 0600 "$man"
  say "  manifest: $man (0600 root:root)"

  install_user "$runtime"
  install_user "$deploy_user" login
  ensure_dir "$BASE_DIR/$svc" 0755 root:root
  ensure_dir "$BASE_DIR/$svc/releases" 0775 "${deploy_user}:${deploy_user}"
  # The staged tree is CI's and is only ever written as DEPLOY_USER, so its
  # ownership follows the manifest. Without this, changing DEPLOY_USER leaves
  # releases owned by the previous identity: the next tar cannot overwrite
  # files it does not own and the deploy fails before the gate is reached.
  chown -R "${deploy_user}:${deploy_user}" "$BASE_DIR/$svc/releases" \
    || die "chown -R $BASE_DIR/$svc/releases"
  say "  tree: $BASE_DIR/$svc (releases owned by $deploy_user)"

  local p paths=""
  for p in $rw; do
    ensure_dir "$p" 0750 "${runtime}:${runtime}"
    chown -R "${runtime}:${runtime}" "$p"
    paths="${paths}${p} "
    say "  state: $p (owned by $runtime)"
  done
  paths="${paths% }"

  write_dropin "$svc" "$runtime" "$paths"
  write_sudoers "$deploy_user" "$svc"

  CREATED_SITE=""
  write_site "$svc" "$domain" "$ip" "$port"
  [ -n "$CREATED_SITE" ] && reload_caddy

  systemctl daemon-reload
  systemctl enable "utmelab@$svc" >/dev/null 2>&1 && say "  unit enabled: utmelab@$svc"
  hr
  say "${B}next${D}"
  say "  1. hand CI a key for this identity (public half only):"
  say "       sudo system enroll $svc /path/to/id_ed25519.pub"
  say "     then set VPS_USER=${deploy_user} and VPS_SSH_KEY in the repo's secrets."
  say "  2. stage a release and activate it: sudo deploy-service $svc <version>"
  say "  3. confirm the contract holds:        sudo system verify"
}

# ============================================================================
# enroll — register a CI public key for a service's deploy identity
# ============================================================================
cmd_enroll() {
  need_root
  local svc="${1:-}" keyfile="${2:-}"
  [ -n "$svc" ] && [ -n "$keyfile" ] || die "usage: system enroll <service> <public-key-file>"
  [ -f "$(manifest "$svc")" ] || die "no manifest for $svc"
  [ -f "$keyfile" ] || die "no such file: $keyfile"
  local deploy_user home ak key
  deploy_user="$(env_or "$svc" DEPLOY_USER "deploy-$svc")"
  id -u "$deploy_user" >/dev/null 2>&1 || die "user $deploy_user does not exist: run provision first"
  home="$(getent passwd "$deploy_user" | cut -d: -f6)"
  ak="${home}/.ssh/authorized_keys"
  key="$(grep -vE '^[[:space:]]*(#|$)' "$keyfile" | head -n1)"
  [[ "$key" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+)[[:space:]]+[A-Za-z0-9+/=]+ ]] \
    || die "$keyfile does not look like a public key"

  install -d -m 0700 -o "$deploy_user" -g "$deploy_user" "${home}/.ssh"
  touch "$ak"; chmod 0600 "$ak"; chown "$deploy_user:$deploy_user" "$ak"
  if grep -qF "$(printf '%s' "$key" | awk '{print $2}')" "$ak"; then
    say "already enrolled for $deploy_user"
  else
    printf 'no-port-forwarding,no-agent-forwarding,no-X11-forwarding %s\n' "$key" >>"$ak"
    say "enrolled into $ak"
  fi
  say "fingerprint: $(printf '%s' "$key" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')"
}

# ============================================================================
# verify — does the host still match the manifests?
# ============================================================================
site_port() { # svc
  local f="${SITE_DIR}/$1.caddy"
  [ -f "$f" ] || return 1
  awk '/reverse_proxy/ {for (i = 1; i <= NF; i++) if ($i ~ /^[0-9.]+:[0-9]+$/) {split($i, a, ":"); print a[2]; exit}}' "$f"
}

cmd_verify() {
  need_root
  local svc
  printf '%sVERIFY%s  manifests vs host\n' "$B" "$D"; hr

  say "${B}host${D}"
  systemctl is-active --quiet caddy 2>/dev/null && ok "caddy active" || bad "caddy is not active"
  if [ -f "$CADDY_FILE" ]; then
    grep -q 'sites/\*\.caddy' "$CADDY_FILE" \
      && ok "main Caddyfile imports sites/*.caddy" \
      || bad "main Caddyfile does not import sites/*.caddy: per-service sites are inert"
    if command -v caddy >/dev/null 2>&1; then
      caddy validate --config "$CADDY_FILE" --adapter caddyfile >/dev/null 2>&1 \
        && ok "caddy validate passes" || bad "caddy validate fails"
    fi
  else
    bad "no $CADDY_FILE"
  fi
  local f
  for f in /etc/systemd/system/*.service; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
    utmelab@.service) ;;
    utmelab*.service)
      bad "legacy per-app unit present: $(basename "$f") (two units would own one port)"
      ;;
    *) ;;
    esac
  done
  for f in /usr/local/bin/utmelab-deploy /usr/local/bin/utmelab-api-deploy; do
    [ -f "$f" ] && warn "legacy gate still installed: $f"
  done
  local s
  for s in "${SUDOERS_DIR}"/*; do
    [ -f "$s" ] || continue
    while IFS= read -r cmd; do
      [ -x "$cmd" ] || bad "$(basename "$s") allows a command that no longer exists: $cmd"
    done < <(awk '!/^[[:space:]]*#/ && NF {for (i = 1; i <= NF; i++) if ($i ~ /^\//) print $i}' "$s")
  done
  ufw status 2>/dev/null | head -1 | grep -q active && ok "ufw active" || warn "ufw is not active"

  for svc in $(list_services); do
    hr
    say "${B}service ${svc}${D}"
    local man; man="$(manifest "$svc")"
    local perms; perms="$(stat -c '%U:%G %a' "$man" 2>/dev/null)"
    [ "$perms" = "root:root 600" ] \
      && ok "manifest 0600 root:root" \
      || bad "manifest is $perms, want root:root 600"

    local runtime deploy_user
    runtime="$(env_or "$svc" RUNTIME_USER "$svc")"
    deploy_user="$(env_or "$svc" DEPLOY_USER "deploy-$svc")"
    local want_port; want_port="$(env_of "$svc" PORT)"
    local expect; expect="$(env_or "$svc" HEALTH_EXPECT 200)"

    unit_enabled "$svc" | grep -q enabled && ok "unit enabled (utmelab@$svc)" || bad "unit not enabled: it will not come back after reboot"
    if unit_active "$svc"; then
      local pid ruser
      pid="$(systemctl show -p MainPID --value "utmelab@$svc")"
      ruser="$(ps -o user= -p "${pid:-0}" 2>/dev/null | tr -d ' ')"
      [ "$ruser" = "$runtime" ] && ok "running as $runtime" || bad "runs as '${ruser:-?}', manifest says $runtime"
    else
      bad "unit $(unit_state "$svc")"
    fi

    id -u "$runtime" >/dev/null 2>&1 && ok "runtime user exists: $runtime" || bad "runtime user missing: $runtime"
    id -u "$deploy_user" >/dev/null 2>&1 && ok "CI identity exists: $deploy_user" || bad "CI identity missing: $deploy_user (no CI can deploy $svc)"
    local rule="${SUDOERS_DIR}/deploy-${svc}"
    if [ -f "$rule" ] && grep -q "^${deploy_user} ALL=(root) NOPASSWD: ${DEPLOY_GATE}$" "$rule"; then
      ok "sudoers rule scoped to $deploy_user"
    else
      bad "no scoped sudoers rule at $rule"
    fi

    local sp; sp="$(site_port "$svc" || true)"
    if [ -z "$(env_of "$svc" DOMAIN)" ]; then
      ok "no DOMAIN: loopback-only by design"
    elif [ -z "$sp" ]; then
      bad "no site file or no reverse_proxy in ${SITE_DIR}/${svc}.caddy"
    elif [ "$sp" = "$want_port" ]; then
      ok "port agrees: manifest and Caddy both $want_port"
    else
      bad "port mismatch: manifest $want_port, Caddy $sp (this is the 502 fault)"
    fi

    local code; code="$(http_code "$(health_url "$svc")")"
    [ "$code" = "$expect" ] && ok "local health $code" || bad "local health $code, want $expect at $(health_url "$svc")"
    local domain; domain="$(env_of "$svc" DOMAIN)"
    if [ -n "$domain" ]; then
      local pub; pub="$(http_code "https://${domain}$(env_or "$svc" HEALTH_ENDPOINT /)" 15)"
      [ "$pub" = "$expect" ] && ok "public health $pub" || warn "public health $pub at https://${domain}"
    fi

    local cur n
    cur="$(basename "$(readlink -f "${BASE_DIR}/$svc/current" 2>/dev/null)" 2>/dev/null)"
    n="$(find "${BASE_DIR}/$svc/releases" -mindepth 1 -maxdepth 1 -type d -name 'v*' 2>/dev/null | wc -l)"
    say "  ... releases: current=${cur:-none}, $n on disk, keep=$(( $(env_or "$svc" KEEP_RELEASES 3) + 1 ))"
  done

  hr
  printf '%s%d service(s), %d failure(s), %d warning(s)%s\n' \
    "$([ "$ISSUES" -eq 0 ] && printf '%s' "$G" || printf '%s' "$R")" \
    "$(list_services | grep -c . )" "$ISSUES" "$WARNINGS" "$D"
  [ "$ISSUES" -eq 0 ] || return 1
}

# ============================================================================
# report / preview / rollback
# ============================================================================
cmd_report() {
  need_root
  say "${B}SYSTEM REPORT${D}"; hr
  say "${B}UPTIME / LOAD${D}"; uptime -p | sed 's/^up //'; say "Load avg: $(cut -d' ' -f1-3 /proc/loadavg) ($(nproc) vCPU)"; hr

  local mem_used mem_tot mem_avail sw_tot sw_used
  mem_used=$(awk '/^MemTotal:/{t=$2}/^MemAvailable:/{a=$2}END{print int((t-a)/1024)}' /proc/meminfo)
  mem_tot=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
  sw_tot=$(awk '/^SwapTotal:/{print int($2/1024)}' /proc/meminfo)
  sw_used=$(awk '/^SwapTotal:/{t=$2}/^SwapFree:/{f=$2}END{print int(t>0?(t-f)/1024:0)}' /proc/meminfo)
  say "${B}MEMORY${D}"
  printf '  Total: %6d MiB   Used: %6d MiB   Avail: %6d MiB\n' "$mem_tot" "$mem_used" "$mem_avail"
  printf '  Swap:  %6d MiB   Used: %6d MiB\n' "$sw_tot" "$sw_used"; hr

  say "${B}DISK${D}"; df -h / | awk 'NR==2 {printf "  Root: %s used / %s total (%s)\n", $3, $2, $5}'
  local svc
  for svc in $(list_services); do
    local d="${BASE_DIR}/$svc"; [ -d "$d" ] || continue
    say "  ${svc}  $(du -shL "$d/current" 2>/dev/null | cut -f1)  active -> $(basename "$(readlink -f "$d/current" 2>/dev/null)")"
  done; hr

  say "${B}SERVICES${D}"
  for svc in $(list_services); do
    if unit_active "$svc"; then
      local pid rss
      pid="$(systemctl show -p MainPID --value "utmelab@$svc")"
      rss="$(awk '/^VmRSS:/{print int($2/1024) " MiB"}' "/proc/$pid/status" 2>/dev/null)"
      printf '  %sactive%s   %-14s pid=%-7s mem=%-9s since=%s\n' "$G" "$D" "$svc" "$pid" "${rss:-?}" \
        "$(systemctl show -p ActiveEnterTimestamp --value "utmelab@$svc")"
    else
      printf '  %sinactive%s %-14s\n' "$R" "$D" "$svc"
    fi
  done; hr

  say "${B}ENDPOINTS${D}"
  for svc in $(list_services); do
    local expect domain
    expect="$(env_or "$svc" HEALTH_EXPECT 200)"; domain="$(env_of "$svc" DOMAIN)"
    printf '  %-14s local=%-4s want=%-4s public=%s\n' "$svc" "$(http_code "$(health_url "$svc")")" "$expect" \
      "$([ -n "$domain" ] && http_code "https://${domain}$(env_or "$svc" HEALTH_ENDPOINT /)" 15 || printf 'n/a')"
  done; hr

  say "${B}FLAGS${D}"
  say "  Failed systemd units: $(systemctl --failed --plain --no-legend 2>/dev/null | wc -l)"
  say "  UFW: $(ufw status 2>/dev/null | head -1)"
  say "  OS: $(grep PRETTY /etc/os-release | cut -d'"' -f2)  Kernel: $(uname -r)"
  say "  Journal: $(journalctl --disk-usage 2>/dev/null | sed 's/.*take up //;s/ in the file system.*//')"
  say "  Root SSH: $(sshd -T 2>/dev/null | awk '/^permitrootlogin /{print $2; exit}')"
}

cmd_deploy_preview() {
  need_root
  say "${B}DEPLOY PREVIEW${D} (read-only)"; hr
  local svc
  say "${B}LIVE NOW${D}"
  for svc in $(list_services); do
    local cur domain code
    cur="$(basename "$(readlink -f "${BASE_DIR}/$svc/current" 2>/dev/null)" 2>/dev/null)"
    domain="$(env_of "$svc" DOMAIN)"
    code="$([ -n "$domain" ] && http_code "https://${domain}$(env_or "$svc" HEALTH_ENDPOINT /)" 15 || http_code "$(health_url "$svc")")"
    printf '  %-14s %-22s %-10s %s\n' "$svc" "${cur:-none}" "$(unit_state "$svc")" "$code"
  done; hr

  say "${B}PRUNE PLAN${D} (newest first, by mtime)"
  for svc in $(list_services); do
    local d="${BASE_DIR}/$svc"; [ -d "$d/releases" ] || continue
    local keep active n=0 r
    keep="$(env_or "$svc" KEEP_RELEASES 3)"
    active="$(readlink -f "$d/current" 2>/dev/null)"
    printf '  %s  keep=%s superseded\n' "$svc" "$keep"
    while IFS= read -r r; do
      n=$((n + 1))
      if [ "$r" = "$active" ]; then
        printf '    %-24s %6s  live\n' "$(basename "$r")" "$(du -sh "$r" 2>/dev/null | cut -f1)"
      elif [ "$n" -gt "$((keep + 1))" ]; then
        printf '    %-24s %6s  would be pruned\n' "$(basename "$r")" "$(du -sh "$r" 2>/dev/null | cut -f1)"
      else
        printf '    %-24s %6s  rollback target (%d of %s)\n' "$(basename "$r")" "$(du -sh "$r" 2>/dev/null | cut -f1)" "$((n - 1))" "$keep"
      fi
    done < <(find "$d/releases" -mindepth 1 -maxdepth 1 -type d -name 'v*' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
  done
}

cmd_rollback() {
  need_root
  local svc="${1:-}"
  [ -n "$svc" ] || die "usage: system rollback <service>"
  local d="${BASE_DIR}/$svc"
  [ -d "$d/releases" ] || die "no releases for $svc"
  local active target
  active="$(readlink -f "$d/current" 2>/dev/null)"
  target="$(find "$d/releases" -mindepth 1 -maxdepth 1 -type d -name 'v*' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | cut -d' ' -f2- | grep -v "^${active}$" | head -n1)"
  [ -n "$target" ] || die "no other release to roll back to"
  local back; back="$(basename "$active")"
  say "rolling $svc back: $(basename "$target")  (was ${back:-none})"
  ln -sfn "releases/$(basename "$target")" "$d/current"
  chmod -R o+rX "$target"
  systemctl restart "utmelab@$svc"
  local expect code="" i
  expect="$(env_or "$svc" HEALTH_EXPECT 200)"
  for i in $(seq 1 15); do
    code="$(http_code "$(health_url "$svc")")"
    [ "$code" = "$expect" ] && break
    sleep 1
  done
  if [ "$code" = "$expect" ]; then
    say "rolled back to $(basename "$target") (health $code)"
    return 0
  fi
  say "rollback target answered $code, want $expect: restoring ${back:-previous}"
  [ -n "$active" ] && ln -sfn "releases/${back}" "$d/current"
  systemctl restart "utmelab@$svc"
  cmd_deploy_preview >/dev/null 2>&1 || true
  die "rollback failed, ${back:-previous} restored (health $code)"
}

cmd_service_list() { list_services; }

cmd_service_show() {
  local svc="${1:-}"
  [ -n "$svc" ] || die "usage: system service show <service>"
  local man; man="$(manifest "$svc")"
  [ -f "$man" ] || die "service not found: $svc"
  say "${B}MANIFEST ${svc}${D}  ($man, $(stat -c '%U:%G %a' "$man"))"; hr
  grep -vE '^[[:space:]]*(#|$)' "$man" | sed 's/^/  /'
  hr
}

# ============================================================================
# root SSH posture
# ============================================================================
effective_root() { sshd -T 2>/dev/null | awk '/^permitrootlogin /{print $2; exit}' | sed 's/without-password/prohibit-password/'; }
admin_path_ok() { local u; for u in shedrack deploy; do id "$u" >/dev/null 2>&1 && [ -s "/home/$u/.ssh/authorized_keys" ] && { printf '%s' "$u"; return 0; }; done; return 1; }
sshd_port() { sshd -T 2>/dev/null | awk '/^port /{print $2; exit}'; }

set_permit_root() {
  local want="$1" backup prev got
  [ -f /etc/ssh/sshd_config.d/00-security.conf ] || die "drop-in not found"
  prev=$(awk '/^PermitRootLogin /{print $2; exit}' /etc/ssh/sshd_config.d/00-security.conf); [ -n "$prev" ] || prev=$(effective_root)
  backup=$(mktemp); cp /etc/ssh/sshd_config.d/00-security.conf "$backup"
  sed -i "s/^PermitRootLogin .*/PermitRootLogin ${want}/" /etc/ssh/sshd_config.d/00-security.conf
  sshd -t || { cp "$backup" /etc/ssh/sshd_config.d/00-security.conf; rm -f "$backup"; die "sshd -t failed"; }
  setsid systemctl reload ssh >/dev/null 2>&1 </dev/null; sleep 2
  got=$(effective_root); [ "$got" = "$want" ] || { cp "$backup" /etc/ssh/sshd_config.d/00-security.conf; setsid systemctl reload ssh >/dev/null 2>&1; die "revert: got $got"; }
  rm -f "$backup"
  say "effective: ${G}${got}${D}"
}

probe_root() {
  local err
  err=$(timeout 10 ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p "$(sshd_port)" root@127.0.0.1 'echo ok' 2>&1)
  case "$err" in ok*) printf 'ok' ;; *"Permission denied"*) printf 'allowed' ;; *) printf 'blocked' ;; esac
}

cmd_root() {
  need_root
  local sub="${1:-status}"
  say "$(date -Is)  system root ${sub}"
  case "$sub" in
  on)
    local cur
    cur=$(effective_root); [ "$cur" != "no" ] && { say "already ${cur}"; return 0; }
    local admin; admin=$(admin_path_ok) || die "no admin key (shedrack/deploy), cannot enable root"
    say "admin fallback: ${G}${admin}${D}"; set_permit_root prohibit-password
    case "$(probe_root)" in ok) say "probe: ${G}authenticated${D}" ;; allowed) say "probe: ${Y}policy allows, no key here${D}" ;; *) say "probe: ${R}refused${D}"; die "root SSH not enabled" ;; esac
    ;;
  off)
    set_permit_root no
    [ "$(probe_root)" = "ok" ] && die "root still accessible" || say "probe: ${G}refused${D}"
    ;;
  status)
    local e col
    e=$(effective_root)
    case "$e" in no) col="$G" ;; prohibit-password) col="$Y" ;; *) col="$R" ;; esac
    printf '\n%sROOT SSH%s  permitrootlogin = %s%s%s\n' "$B" "$D" "$col" "$e" "$D"
    printf '  port: %s\n  admin: %s\n' "$(sshd_port)" "$(admin_path_ok || echo NONE)"
    ;;
  *) die "usage: system root on|off|status" ;;
  esac
}

usage() {
  cat <<'USAGE'
system — one admin tool for every service on this host

  system provision <service>        create/repair everything the manifest implies
  system enroll <service> <key>     register a CI public key for deploy-<service>
  system verify                     check every service against its manifest
  system report                     resource + service health
  system deploy preview             what a deploy would do (read-only)
  system rollback <service>         flip back to the previous release
  system service list               the manifests on this host
  system service show <service>     one manifest
  system root status|on|off         root SSH posture
  system help                       this text

A service is ONE file: /etc/deploy-service/<service>.env (0600 root:root).
Everything else is generated from it by `system provision`.
USAGE
}

case "${1:-help}" in
provision) shift; cmd_provision "$@" ;;
enroll) shift; cmd_enroll "$@" ;;
verify) shift; cmd_verify "$@" ;;
report) shift; cmd_report "$@" ;;
deploy | preview) shift; cmd_deploy_preview "$@" ;;
rollback) shift; cmd_rollback "$@" ;;
service) shift; [ "${1:-}" = "list" ] && cmd_service_list || cmd_service_show "${2:-$1}" ;;
root) shift; cmd_root "$@" ;;
help | -h | --help) usage ;;
*)
  printf 'unknown: %s\n\n' "$1" >&2
  usage >&2
  exit 1
  ;;
esac
