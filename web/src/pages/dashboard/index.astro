---
// The dashboard. A static shell (dev_docs/QUESTION_BANK_DECISIONS.md D32): it
// holds no data itself — the browser fetches it from /internal/v1/* after
// load, so nothing here needs a server.
const planned = ['Sign in', 'Your API key', 'Usage', 'Billing'];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dashboard — UTME Lab API</title>
		<meta name="description" content="Your API key, usage and billing." />
	</head>
	<body>
		<main>
			<h1>Dashboard</h1>
			<p>Not built yet. When it lands, this page holds:</p>
			<ul>
				{
					planned.map((item) => (
						<li>{item}</li>
					))
				}
			</ul>
			<p>
				<a href="/docs/">Read the documentation</a> in the meantime.
			</p>
			<div id="account" hidden>
				<!-- Populated from /internal/v1/me after sign-in. -->
			</div>
		</main>
	</body>
</html>

<style>
	main {
		max-width: 42rem;
		margin: 4rem auto;
		padding: 0 1.5rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}
	h1 {
		color: var(--utmelab-accent, #0f766e);
	}
	li {
		margin-block: 0.5rem;
	}
</style>
