{
  "openapi": "3.1.0",
  "info": {
    "title": "UTME Lab Question Bank API",
    "description": "Every candidate writes English plus three others. Questions are keyed to subtopics so a weak spot is a 20-question sitting, not a 40-question paper. Explanations are Markdown and carry the trap that catches people.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://api.utmelab.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/v1/exams": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "listExams",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exams/{exam}/subjects": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "listSubjects",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "description": "Exam code, e.g. JAMB",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamSubjects"
                }
              }
            }
          },
          "404": {
            "description": "No such exam"
          }
        }
      }
    },
    "/api/v1/keys/me": {
      "get": {
        "tags": [
          "account"
        ],
        "description": "Returns the calling key exactly as stored. Use it to check a key works.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKey"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Over the key's per-minute limit"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/novels": {
      "get": {
        "tags": [
          "novels"
        ],
        "description": "All novels, newest prescription first. No key required.",
        "operationId": "listNovels",
        "parameters": [
          {
            "name": "exam",
            "in": "query",
            "description": "Scope to an exam.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "description": "Prescription year, e.g. 2025.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "featured",
            "in": "query",
            "description": "Only the current set text.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "english (reading text) or literature (prescribed text).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NovelList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/novels/{id}": {
      "get": {
        "tags": [
          "novels"
        ],
        "description": "One novel: book, chapters, characters, themes. No key required.",
        "operationId": "getNovel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Novel id, e.g. lekki-headmaster.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NovelDoc"
                }
              }
            }
          },
          "404": {
            "description": "No such novel"
          }
        }
      }
    },
    "/api/v1/novels/{id}/questions": {
      "get": {
        "tags": [
          "novels"
        ],
        "description": "Quiz items for one novel, paged. The answer is withheld unless asked.",
        "operationId": "listNovelQuestions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Novel id.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chapter",
            "in": "query",
            "description": "Drill one chapter.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "include_explanation",
            "in": "query",
            "description": "Include the answer and the working. Default: false.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number. Default: 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Page size. Default: 50. Capped at 200.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NovelQuestionPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "404": {
            "description": "No such novel"
          },
          "429": {
            "description": "Over the key's per-minute limit"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/passages/{id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "description": "One shared stimulus — a comprehension or cloze passage its questions point at.",
        "operationId": "getPassage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Passage id.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PassageEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such passage"
          }
        }
      }
    },
    "/api/v1/questions": {
      "get": {
        "tags": [
          "questions"
        ],
        "description": "Paged, and the answer is withheld unless you ask for it.\n\n**The answer is only in the response when `include_explanation=true`.** A quiz consumer needs the stem first, and an answer in a default payload gets rendered by somebody, eventually, by accident.\n\nRender option labels from array position: ids are stable identity, labels are display.",
        "operationId": "listQuestions",
        "parameters": [
          {
            "name": "subtopic",
            "in": "query",
            "description": "Drill one subtopic.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exam",
            "in": "query",
            "description": "Scope to an exam.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subject",
            "in": "query",
            "description": "Scope to a subject within that exam.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "description": "Only human-checked questions. Default: no filter.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "include_explanation",
            "in": "query",
            "description": "Include the answer and the working. Default: false.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number. Default: 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Page size. Default: 50. Capped at 200.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionPage"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "404": {
            "description": "No such subject, or no usable filter"
          },
          "429": {
            "description": "Over the key's per-minute limit"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/subjects/{exam}/{slug}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "getSubject",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "description": "Exam code.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "The exam's own name for this subject.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such subject in that exam"
          }
        }
      }
    },
    "/api/v1/subjects/{exam}/{slug}/coverage": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Coverage without the tree: counts only, for progress bars and checklists.",
        "description": "How much of this subject you can practise — counts only, no topic tree.",
        "operationId": "getCoverage",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "description": "Exam code.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "Subject slug within that exam.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            }
          },
          "404": {
            "description": "No such subject in that exam"
          }
        }
      }
    },
    "/api/v1/subjects/{exam}/{slug}/syllabus": {
      "get": {
        "tags": [
          "catalog"
        ],
        "description": "The whole topic tree for one subject, with a question count and objectives on every node — what you must be able to do, beside what you can actually practise. A topic with no questions does not appear.",
        "operationId": "getSyllabus",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "description": "Exam code.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "Subject slug within that exam.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Syllabus"
                }
              }
            }
          },
          "404": {
            "description": "No such subject in that exam"
          }
        }
      }
    },
    "/api/v1/topics/{exam}/{subject}/{slug}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "description": "One topic with its subtopics, each carrying its question count and objectives.",
        "operationId": "getTopic",
        "parameters": [
          {
            "name": "exam",
            "in": "path",
            "description": "Exam code.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "description": "Subject slug within that exam.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "description": "Topic slug.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such topic"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "`/health` and `/openapi.json` are real handlers elsewhere; these carry only the\ndocumentation, so the contract can name them without a route item here.",
        "description": "Unauthenticated. Reports question and withheld-record counts.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is up"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "description": "This document.",
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "The OpenAPI description"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKey": {
        "type": "object",
        "description": "A key as stored. Deliberately carries no secret material.",
        "required": [
          "id",
          "label",
          "rate_limit",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "rate_limit": {
            "type": "integer",
            "format": "int32",
            "description": "Per-key request allowance (D26) — a column, not a key *type*.",
            "minimum": 0
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Choice": {
        "type": "object",
        "description": "One answer choice. Named `Choice` because `Option` is Rust's, not ours.\n\n`id` is stable identity; the **label** the student sees (A, B, C…) is\nassigned from array position at render time and is never stored (D15).",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Coverage": {
        "type": "object",
        "description": "Counts without the tree — for progress bars and checklists.",
        "required": [
          "exam",
          "subject",
          "summary"
        ],
        "properties": {
          "exam": {
            "type": "string"
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "summary": {
            "$ref": "#/components/schemas/SyllabusSummary"
          }
        }
      },
      "Exam": {
        "type": "object",
        "required": [
          "code",
          "subject_count"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Exam code, e.g. `JAMB`."
          },
          "subject_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ExamList": {
        "type": "object",
        "required": [
          "exams"
        ],
        "properties": {
          "exams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Exam"
            }
          }
        }
      },
      "ExamSubjects": {
        "type": "object",
        "description": "One exam's subject list.",
        "required": [
          "exam",
          "subjects"
        ],
        "properties": {
          "exam": {
            "type": "string"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subject"
            }
          }
        }
      },
      "Explanation": {
        "type": "object",
        "description": "Why the answer is what it is (D17). `key_point` is the flashcard teaser,\n`body` the working, `trap` the distractor that catches people.",
        "required": [
          "key_point",
          "body"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "key_point": {
            "type": "string"
          },
          "trap": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Novel": {
        "type": "object",
        "description": "A prescribed text. One row per (exam, cycle) — the novel rotates yearly, so\n`year_prescribed` is load-bearing, not decorative.",
        "required": [
          "id",
          "title",
          "author",
          "exam",
          "synopsis",
          "setting_place",
          "setting_period"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Which paper sets it: the Use-of-English reading text, or a\nLiterature-in-English prescribed text. Consumers filter on this."
          },
          "cover_image": {
            "type": [
              "string",
              "null"
            ]
          },
          "exam": {
            "type": "string"
          },
          "featured": {
            "type": "boolean",
            "description": "At most one per exam — enforced at load. The current set text."
          },
          "id": {
            "type": "string"
          },
          "setting_period": {
            "type": "string"
          },
          "setting_place": {
            "type": "string"
          },
          "synopsis": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year_prescribed": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "Every cycle this is (or was) the set text for. A novel routinely spans\nmore than one UTME — *The Lekki Headmaster* covers 2025 and 2026."
          },
          "year_published": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "May be unknown for older set texts — absent, not zero.",
            "minimum": 0
          }
        }
      },
      "NovelChapter": {
        "type": "object",
        "required": [
          "number",
          "title"
        ],
        "properties": {
          "key_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "number": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null means not yet written — absence is the signal (D16)."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "NovelCharacter": {
        "type": "object",
        "description": "Character types use JAMB's own vocabulary (round/flat/foil/hero/antihero/\nvillain/heroine) because that is literally what the syllabus tests.",
        "required": [
          "name",
          "role",
          "character_type",
          "description"
        ],
        "properties": {
          "character_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "NovelDoc": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Novel"
          },
          {
            "type": "object",
            "properties": {
              "chapters": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NovelChapter"
                }
              },
              "characters": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NovelCharacter"
                }
              },
              "questions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NovelQuestion"
                }
              },
              "themes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NovelTheme"
                }
              }
            }
          }
        ],
        "description": "One file in `data/novels/`. The directory is the index — no separate list\nto keep in sync. Dropping a novel is deleting its file."
      },
      "NovelList": {
        "type": "object",
        "required": [
          "novels"
        ],
        "properties": {
          "novels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Novel"
            }
          }
        }
      },
      "NovelQuestion": {
        "type": "object",
        "description": "A quiz item about the book. Reuses Option/answer/Explanation machinery —\na novel question is answered, shuffled and explained exactly like a subject\nquestion. It points at a chapter, not a subtopic, and the novel is the\npassage, so there is no passage_id.",
        "required": [
          "id",
          "text",
          "options",
          "answer",
          "verified"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "description": "An option id, same contract as Question.answer (D15)."
          },
          "chapter_number": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "explanation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "text": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        }
      },
      "NovelQuestionPage": {
        "type": "object",
        "required": [
          "questions",
          "page",
          "per_page",
          "total_pages",
          "total_records",
          "includes_explanation"
        ],
        "properties": {
          "includes_explanation": {
            "type": "boolean"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "per_page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "questions": {
            "type": "array",
            "items": {
