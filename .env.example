# Mirrors the defaults in src/config.rs. Copy to .env for local work; the
# deploy host uses /etc/utmelab-api/environment instead. Parsing is strict: a
# variable that is set must be valid or boot fails naming it, and a blank
# value counts as unset.
PORT=3100
WORKER_THREADS=2
MAX_BLOCKING_THREADS=32
CONCURRENCY_LIMIT=1000
DB_MAX_CONCURRENT=16
SYNC_SECS=10
REPLICA_PATH=db/sync.db
READ_TIMEOUT_SECS=5
WRITE_TIMEOUT_SECS=30
# The public docs promise 60/minute per key; keep this equal to that promise.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=0
COOKIE_SECURE=1
TURSO_DB_URL=
TURSO_DB_TOKEN=
RUST_LOG=info
