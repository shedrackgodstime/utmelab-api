# Mirrors the defaults in src/config.rs. Copy to .env for local work; the
# deploy host uses /etc/utmelab-api/environment instead. Parsing is strict: a
# variable that is set must be valid or boot fails naming it, and a blank
# value counts as unset.
PORT=3100
WORKER_THREADS=2
MAX_BLOCKING_THREADS=32
CONCURRENCY_LIMIT=1000
DB_MAX_CONCURRENT=16
SYNC_IDLE_SECS=300
SYNC_LONG_POLL_SECS=3
# Every engine operation has a budget. A stalled remote must release the
# write lock and become a typed timeout, not wedge the process.
SYNC_BUILD_TIMEOUT_SECS=60
SYNC_CONNECT_TIMEOUT_SECS=5
SYNC_PULL_TIMEOUT_SECS=30
SYNC_PUSH_TIMEOUT_SECS=30
SYNC_STATS_TIMEOUT_SECS=5
SYNC_VERIFY_TIMEOUT_SECS=15
SYNC_SHUTDOWN_TIMEOUT_SECS=15
# Transient failures back off exponentially with additive jitter. Permanent
# failures use the slow probe and block readiness.
SYNC_RETRY_BASE_SECS=5
SYNC_RETRY_MAX_SECS=60
SYNC_RETRY_FACTOR=2
SYNC_RETRY_JITTER_PCT=20
SYNC_PERMANENT_PROBE_SECS=300
# Content may be older than credentials. A stale revocation list is a
# security boundary, so auth gets the tighter budget.
SYNC_MAX_STALENESS_SECS=900
SYNC_AUTH_MAX_STALENESS_SECS=300
SYNC_HEARTBEAT_MAX_SECS=180
# Local work committed during a push outage is bounded. New writes are
# refused once either pending limit is reached.
SYNC_MAX_PENDING_OPERATIONS=256
SYNC_MAX_PENDING_BYTES=67108864
REPLICA_PATH=db/sync.db
READ_TIMEOUT_SECS=5
WRITE_TIMEOUT_SECS=30
# The public docs promise 60/minute per key; keep this equal to that promise.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=0
COOKIE_SECURE=1
TURSO_DB_URL=
TURSO_DB_TOKEN=
# Optional development-only key for local keyed endpoint benchmarks.
UTMELAB_DEV_API_KEY=
RUST_LOG=info
