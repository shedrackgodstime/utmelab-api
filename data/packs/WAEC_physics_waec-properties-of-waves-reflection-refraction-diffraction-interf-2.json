    {
      "id": "phy_wave_optics:trap-3",
      "chapter_id": "phy_wave_optics",
      "status": "candidate",
      "section_id": "sec-4",
      "misconception": {
        "text": "The fringe spacing in Young's double slit experiment is inversely proportional to the wavelength.",
        "inline": []
      },
      "correction": {
        "text": "It is directly proportional to the wavelength and inversely proportional to the slit separation, since the spacing is $\\frac{\\lambda L}{d}$. A longer wavelength gives wider fringes.",
        "inline": []
      },
      "signal": {
        "text": "Our own question offers the inverse reading as an option.",
        "inline": []
      },
