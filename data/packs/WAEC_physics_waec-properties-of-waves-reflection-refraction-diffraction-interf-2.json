  "recall_checks": [
    {
      "id": "phy_wave_optics:rc-1",
      "chapter_id": "phy_wave_optics",
      "section_id": "sec-4",
      "stem": {
        "text": "In Young's double slit experiment, the fringe spacing is",
        "inline": []
      },
      "options": [
        {
          "id": "a",
          "text": "independent of the slit separation"
        },
        {
          "id": "b",
          "text": "directly proportional to the wavelength"
        },
        {
          "id": "c",
          "text": "inversely proportional to the wavelength"
        },
        {
          "id": "d",
          "text": "independent of the distance to the screen"
        }
      ],
      "answer": "b",
      "explanation": {
        "text": "The fringe spacing is $\\Delta y = \\frac{\\lambda L}{d}$, so it grows with the wavelength and shrinks as the slits are moved apart.",
        "inline": []
      },
      "difficulty": 3
    },
    {
      "id": "phy_wave_optics:rc-2",
      "chapter_id": "phy_wave_optics",
      "section_id": "sec-3",
      "stem": {
        "text": "Huygens' principle says that every point on a wavefront acts as",
        "inline": []
      },
      "options": [
        {
          "id": "a",
          "text": "a reflector of rays"
        },
        {
          "id": "b",
          "text": "a source of secondary wavelets"
        },
        {
          "id": "c",
          "text": "a mirror"
        },
        {
          "id": "d",
          "text": "an emitter of particles"
        }
      ],
      "answer": "b",
      "explanation": {
        "text": "Huygens' principle treats each point of a wavefront as a source of secondary wavelets, and the later wavefront is their envelope. It is what explains diffraction.",
        "inline": []
      },
      "difficulty": 2
    }
