      "section_id": "sec-5",
      "misconception": {
        "text": "A factor with a negative index can be used as it is.",
        "inline": []
      },
      "correction": {
        "text": "A negative index means the reciprocal, so $125^{-1/3} = 1/5$ and $49^{-1/2} = 1/7$, and the product is $1/35$.",
