      "id": "trap-4",
      "section_id": "sec-8",
      "misconception": {
        "text": "Only the first radical in an expression needs simplifying.",
        "inline": []
      },
      "correction": {
        "text": "Every radical must be written as the same surd before they can be combined: $\\sqrt{75} = 5\\sqrt{3}$, $\\sqrt{12} = 2\\sqrt{3}$ and $\\sqrt{27} = 3\\sqrt{3}$.",
