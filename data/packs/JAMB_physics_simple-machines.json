      "misconception": {
        "text": "The output work of a machine is the input work divided by the efficiency.",
        "inline": []
      },
      "correction": {
        "text": "The output work is the input work multiplied by the efficiency, and the mechanical advantage is the load over the effort.",
        "inline": []
      },
