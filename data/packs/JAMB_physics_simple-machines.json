      "id": "phy_statics_and_torque:rc-7",
      "chapter_id": "phy_statics_and_torque",
      "section_id": "sec-6",
      "stem": {
        "text": "A machine has a mechanical advantage of 3 and an efficiency of 50%. What effort is needed to raise a load of 120 N?",
        "inline": []
      },
      "options": [
        {
          "id": "a",
          "text": "20 N"
        },
        {
          "id": "b",
          "text": "40 N"
        },
        {
          "id": "c",
          "text": "60 N"
        },
        {
          "id": "d",
          "text": "360 N"
        }
      ],
      "answer": "b",
      "explanation": {
        "text": "The mechanical advantage is the load over the effort, so the effort is 120/3 = 40 N. The efficiency does not change the mechanical advantage.",
        "inline": []
      },
      "difficulty": 3
    }
