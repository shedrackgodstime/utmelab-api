      "misconception": {
        "text": "When surds are added, the numbers under the radical signs are added.",
        "inline": []
      },
      "correction": {
        "text": "Each surd is written as the same surd first, so $\\sqrt{12} + \\sqrt{27} = 2\\sqrt{3} + 3\\sqrt{3} = 5\\sqrt{3}$.",
        "inline": []
