      "stem": {
        "text": "Write $\\frac{4}{1+\\sqrt{5}}$ in its simplest form.",
        "inline": []
      },
      "options": [
        {
          "id": "a",
          "text": "$1+\\sqrt{5}$"
        },
        {
          "id": "b",
          "text": "$\\sqrt{5}-1$"
        },
        {
          "id": "c",
          "text": "$4(\\sqrt{5}-1)$"
        },
        {
          "id": "d",
          "text": "$\\frac{\\sqrt{5}}{4}$"
        }
      ],
      "answer": "b",
      "explanation": {
        "text": "Multiply by the conjugate $1-\\sqrt{5}$. The denominator becomes $1-5 = -4$, so the result is $\\sqrt{5}-1$.",
        "inline": []
      },
      "difficulty": 3
