      "stem": {
        "text": "The resultant of a 3 N force to the east and a 4 N force to the north is",
        "inline": []
      },
      "options": [
        {
          "id": "a",
          "text": "1 N"
        },
        {
          "id": "b",
          "text": "5 N"
