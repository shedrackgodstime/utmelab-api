      "misconception": {
        "text": "A heavier body feels a greater pull from the Earth.",
        "inline": []
      },
      "correction": {
        "text": "Every body on the Earth feels the same pull per unit mass. The weight of a body on the Moon is one sixth of its weight on the Earth, whatever its mass.",
