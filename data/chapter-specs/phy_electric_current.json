    {
      "id": "sec-2",
      "title": "Current",
      "module": "m42341",
      "est_minutes": 12,
      "locator": "CNXML module m42341",
      "objectives": [
        "Define electric current, ampere, and drift velocity",
        "Describe the direction of charge flow in conventional current.",
        "Use drift velocity to calculate current and vice versa."
      ],
      "misconceptions": [
        {
          "claim": "Current flows through a thicker wire faster.",
          "correction": "Current is the rate of flow of charge. A thicker wire is a smaller resistance, so more charge passes each second."
        }
      ],
      "summary": [
        "Electric current I is the rate at which charge flows, given by I=ΔQΔt , where ΔQ is the amount of charge passing through an area in time Δt.",
        "The direction of conventional current is taken as the direction in which positive charge moves.",
        "The SI unit for current is the ampere (A), where 1 A = 1 C/s."
      ],
      "tags": [],
      "facts_inherited": true,
