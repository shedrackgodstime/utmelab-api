    {
      "id": "sec-3",
      "title": "Ohm’s Law: Resistance and Simple Circuits",
      "module": "m42344",
      "est_minutes": 12,
      "locator": "CNXML module m42344",
      "objectives": [
        "Explain the origin of Ohm’s law.",
        "Calculate voltages, currents, or resistances with Ohm’s law.",
        "Explain what an ohmic material is.",
        "Describe a simple circuit."
      ],
      "misconceptions": [],
      "summary": [
        "A simple circuit is one in which there is a single voltage source and a single resistance.",
        "One statement of Ohm’s law gives the relationship between current I , voltage V , and resistance R in a simple circuit to be I=VR.",
        "Resistance has units of ohms ( Ω ), related to volts and amperes by 1 Ω= 1 V/A."
      ],
      "tags": [],
