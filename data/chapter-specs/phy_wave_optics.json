    {
      "id": "sec-4",
      "title": "Young’s Double Slit Experiment",
      "module": "m42508",
      "est_minutes": 12,
      "locator": "CNXML module m42508",
      "objectives": [
        "Explain the phenomena of interference.",
        "Define constructive interference for a double slit and destructive interference for a double slit."
      ],
      "misconceptions": [
        {
          "claim": "Two beams of light crossing produce a bright spot where they cross.",
          "correction": "They pass through each other. The bright fringes of an interference pattern come from the two beams overlapping, not from them colliding."
        }
      ],
      "summary": [
        "Young’s double slit experiment gave definitive proof of the wave character of light.",
        "An interference pattern is obtained by the superposition of light from two slits.",
        "There is constructive interference when dsinθ=mλ(form=0,1,−1,2,−2,…), where d is the distance between the slits, θ is the angle relative to the incident direction, and m is the order of the interference."
      ],
      "tags": [],
