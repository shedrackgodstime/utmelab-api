    {
      "id": "sec-2",
      "title": "Hooke’s Law: Stress and Strain Revisited",
      "module": "m42240",
      "est_minutes": 12,
      "locator": "CNXML module m42240",
      "objectives": [
        "Explain Newton’s third law of motion with respect to stress and deformation.",
        "Describe the restoration of force and displacement.",
        "Calculate the energy in Hooke’s Law of deformation, and the stored energy in a spring."
      ],
      "misconceptions": [
        {
          "claim": "A pendulum swings faster when it is given a bigger push.",
          "correction": "The period of a pendulum does not depend on the push. It depends on the length and on gravity."
        }
      ],
      "summary": [
        "An oscillation is a back and forth motion of an object between two points of deformation.",
        "An oscillation may create a wave, which is a disturbance that propagates from where it was created.",
        "The simplest type of oscillations and waves are related to systems that can be described by Hooke’s law: F=−kx, where F is the restoring force, x is the displacement from equilibrium or deformation, and k is the force constant of the system."
      ],
      "tags": [],
      "facts_inherited": true,
