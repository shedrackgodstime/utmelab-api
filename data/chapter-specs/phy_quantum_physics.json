      "stem": "The Heisenberg uncertainty principle states that",
      "options": [
        {
          "id": "a",
          "text": "the position and the momentum of a particle cannot both be precisely known at the same time"
        },
        {
          "id": "b",
          "text": "an electron cannot exist"
        },
        {
          "id": "c",
          "text": "the speed of light is constant"
        },
