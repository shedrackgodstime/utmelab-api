{
  "$schema": "./schemas/openai.config.schema.json",
  "version": 2,
  "purpose": "Capability routing for authorized OpenAI-compatible free-tier accounts.",
  "secrets": {
    "source": "environment",
    "never_log_values": true,
    "never_store_in_this_file": true
  },
  "defaults": {
    "timeout_seconds": 30,
    "max_retries": 0,
    "max_tokens": 2048,
    "temperature": 0,
    "max_attempts_per_request": 2,
    "cooldown_seconds": 300,
    "health_probe_before_reenable": true
  },
  "error_policy": {
    "failover_to_next_account": ["rate_limit", "quota", "timeout", "provider_unavailable"],
    "do_not_failover": ["authentication", "invalid_request", "input", "output", "schema", "policy", "not_found"],
    "max_consecutive_failures_before_cooldown": 2,
    "never_retry_without_a_new_account_or_health_check": true
  },
  "providers": {
    "nvidia": {
      "protocol": "openai-compatible",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "account_pool": "nvidia-free",
      "status": "enabled",
      "limits": {
        "daily_free_neurons": null,
        "daily_free_neurons_known": false,
        "rate_limit_rpm": null,
        "source": "provider response and dashboard"
      }
    },
    "cloudflare": {
      "protocol": "openai-compatible",
      "base_url": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
      "account_pool": "cloudflare-free",
      "status": "enabled",
      "limits": {
        "daily_free_neurons": 10000,
        "daily_free_neurons_known": true,
        "rate_limit_rpm": 300,
        "source": "https://developers.cloudflare.com/workers-ai/platform/pricing/"
      }
    },
    "openrouter": {
      "protocol": "openai-compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "account_pool": "openrouter-free",
      "status": "discovery_only",
      "limits": {
        "daily_free_neurons": null,
        "daily_free_neurons_known": false,
        "rate_limit_rpm": null,
        "source": "provider dashboard and response headers"
      }
    }
  },
  "accounts": {
    "nvidia-free": [
      {
        "id": "nvidia-01",
        "api_key_env": "NVIDIA_API_KEY",
        "enabled": true,
        "authorized": true,
        "priority": 10
      }
    ],
    "cloudflare-free": [
      {
        "id": "cloudflare-01",
        "account_id_env": "CLOUDFLARE_ACCOUNT_ID_01",
        "api_key_env": "CLOUDFLARE_API_TOKEN_01",
        "enabled": true,
        "authorized": true,
        "priority": 10
      },
      {
        "id": "cloudflare-02",
        "account_id_env": "CLOUDFLARE_ACCOUNT_ID_02",
        "api_key_env": "CLOUDFLARE_API_TOKEN_02",
        "enabled": false,
        "authorized": false,
        "priority": 20
      },
      {
        "id": "cloudflare-03",
        "account_id_env": "CLOUDFLARE_ACCOUNT_ID_03",
        "api_key_env": "CLOUDFLARE_API_TOKEN_03",
        "enabled": false,
        "authorized": false,
        "priority": 30
      }
    ],
    "openrouter-free": [
      {
        "id": "openrouter-01",
        "api_key_env": "OPENROUTER_API_KEY_01",
        "enabled": false,
        "authorized": false,
        "priority": 10
      }
    ]
  },
  "models": {
    "cloudflare-llama4-scout": {
      "provider": "cloudflare",
      "model_id": "@cf/meta/llama-4-scout-17b-16e-instruct",
      "capabilities": ["text", "image_input"],
      "structured_output": "json_object",
      "status": "verified_candidate",
      "observations": {
        "image_latency_seconds": 8.19,
        "image_schema_valid": true,
        "confidence_output_issue": true
      }
    },
    "nvidia-nemotron-super-vl": {
      "provider": "nvidia",
      "model_id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "capabilities": ["text", "image_input"],
      "structured_output": "json_object",
      "status": "unstable_candidate",
      "observations": {
        "image_schema_valid": true,
        "intermittent_provider_errors": true,
        "requires_repeated_benchmark": true
      }
    },
    "nvidia-llama-90b-vision": {
      "provider": "nvidia",
      "model_id": "meta/llama-3.2-90b-vision-instruct",
      "capabilities": ["text", "image_input"],
      "structured_output": "json_object",
      "status": "disabled",
      "observations": {"reason": "image timeout during local-media test"}
    },
    "openrouter-pending": {
      "provider": "openrouter",
      "model_id": "pending_verification",
      "capabilities": [],
      "structured_output": "unknown",
      "status": "discovery_only"
    }
  },
  "tasks": {
    "image_description": {
      "enabled": true,
      "strategy": "consensus",
      "minimum_successful_witnesses": 2,
      "require_distinct_models": true,
      "on_insufficient_witnesses": "block",
      "allowed_model_statuses": ["verified_candidate"],
      "candidates": [
        {"model": "cloudflare-llama4-scout", "account_pool": "cloudflare-free", "priority": 10},
        {"model": "nvidia-nemotron-super-vl", "account_pool": "nvidia-free", "priority": 20}
      ]
    },
    "question_explanation": {
      "enabled": true,
      "strategy": "failover",
      "on_no_provider": "block",
      "allowed_model_statuses": ["verified_candidate", "unstable_candidate"],
      "candidates": [
        {"model": "nvidia-nemotron-super-vl", "account_pool": "nvidia-free", "priority": 10},
        {"model": "cloudflare-llama4-scout", "account_pool": "cloudflare-free", "priority": 20}
      ]
    },
    "topic_classification": {
      "enabled": true,
      "strategy": "failover",
      "on_no_provider": "block",
      "allowed_model_statuses": ["verified_candidate", "unstable_candidate"],
      "candidates": [
        {"model": "nvidia-nemotron-super-vl", "account_pool": "nvidia-free", "priority": 10},
        {"model": "cloudflare-llama4-scout", "account_pool": "cloudflare-free", "priority": 20}
      ]
    }
  },
  "account_selection": {
    "mode": "failover_only",
    "selection_order": "priority_then_health",
    "rotate_on_quota_only": false,
    "rotate_only_on_classified_transient_errors": true,
    "do_not_round_robin_healthy_accounts": true,
    "reserve_unknown_quota": true,
    "persist_health_outside_git": true
  },
  "observability": {
    "record_per_attempt": ["provider", "account_id", "model_id", "task", "started_at", "latency_ms", "status", "error_category", "http_status", "input_tokens", "output_tokens", "quota_headers"],
    "never_record": ["api_key", "auth_token", "raw_prompt", "raw_image_bytes", "raw_provider_response"]
  }
}
