{
  "$schema": "./schemas/openai.config.schema.json",
  "version": 2,
  "purpose": "Configuration for OpenCode and other CLI-based providers.",
  "secrets": {
    "source": "environment",
    "never_log_values": true,
    "never_store_in_this_file": true
  },
  "defaults": {
    "timeout_seconds": 30,
    "max_retries": 0,
    "max_tokens": 2048,
    "temperature": 0,
    "max_attempts_per_request": 2,
    "cooldown_seconds": 300,
    "health_probe_before_reenable": true
  },
  "error_policy": {
    "failover_to_next_account": [
      "rate_limit",
      "quota",
      "timeout",
      "provider_unavailable"
    ],
    "do_not_failover": [
      "authentication",
      "invalid_request",
      "input",
      "output",
      "schema",
      "policy",
      "not_found"
    ],
    "max_consecutive_failures_before_cooldown": 2,
    "never_retry_without_a_new_account_or_health_check": true
  },
  "providers": {
    "nvidia": {
      "protocol": "openai-compatible",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "account_pool": "nvidia-free",
      "status": "enabled",
      "limits": {
        "daily_free_neurons": null,
        "rate_limit_rpm": null
      }
    },
    "opencode": {
      "protocol": "opencode-cli",
      "status": "enabled",
      "note": "Calls opencode run --format json -m <model>. Model name provided via AI_MODEL env var."
    }
  },
  "accounts": {
    "nvidia-free": [
      {
        "id": "nvidia-01",
        "api_key_env": "NVIDIA_API_KEY",
        "enabled": true,
        "authorized": true,
        "priority": 10
      }
    ],
    "opencode-models": [
      {
        "id": "opencode-default",
        "api_key_env": "AI_MODEL",
        "enabled": true,
        "authorized": true,
        "priority": 10
      }
    ]
  },
  "models": {
    "nvidia-nemotron-super-vl": {
      "provider": "nvidia",
      "model_id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "capabilities": [
        "text",
        "image_input"
      ],
      "structured_output": "json_object",
      "status": "unstable_candidate",
      "account_pool": "nvidia-free"
    },
    "opencode-gpt-4": {
      "provider": "opencode",
      "model_id": "opencode/gpt-4",
      "capabilities": [
        "text",
        "image_input"
      ],
      "structured_output": "json",
      "status": "verified_candidate",
      "account_pool": "opencode-models"
    }
  },
  "tasks": {
    "question_explanation": {
      "enabled": true,
      "strategy": "failover",
      "on_no_provider": "block",
      "allowed_model_statuses": [
        "verified_candidate",
        "unstable_candidate"
      ],
      "candidates": [
        {
          "model": "nvidia-nemotron-super-vl",
          "account_pool": "nvidia-free",
          "priority": 10
        },
        {
          "model": "opencode-gpt-4",
          "account_pool": "opencode-models",
          "priority": 20
        }
      ]
    },
    "opencode_task": {
      "enabled": true,
      "strategy": "opencode",
      "on_no_provider": "block",
      "candidates": [
        {
          "model": "opencode-gpt-4",
          "account_pool": "opencode-models",
          "priority": 10
        }
      ]
    }
  },
  "account_selection": {
    "mode": "failover_only",
    "selection_order": "priority_then_health",
    "rotate_on_quota_only": false,
    "rotate_only_on_classified_transient_errors": true,
    "reserve_unknown_quota": true,
    "persist_health_outside_git": true
  },
  "observability": {
    "record_per_attempt": [
      "provider",
      "account_id",
      "model_id",
      "task",
      "started_at",
      "latency_ms",
      "status",
      "error_category",
      "http_status"
    ],
    "never_record": [
      "api_key",
      "auth_token",
      "raw_prompt",
      "raw_image_bytes",
      "raw_provider_response"
    ]
  }
}