# utmelab-bank settings. Copy to .env and fill in. Real environment variables win.

# Production Turso database. READ ONLY. This is where the catalog lives
# (subjects, topics, subtopics, objectives). turso db show <db> --url
TURSO_PROD_DATABASE_URL=
# Read only token for the production database.
# turso db tokens create <db> --read-only
TURSO_PROD_AUTH_TOKEN=

# utmelab-bank's own Turso database. This is where the staging rows live.
# turso db show <db> --url
TURSO_BANK_DATABASE_URL=
# Write token for the bank database.
# turso db tokens create <db>
TURSO_BANK_AUTH_TOKEN=

# GitLab, for pushing the media repository.
GITLAB_TOKEN=

# Nvidia, for the Nvidia models on the OpenCode provider.
NVIDIA_API_KEY=
