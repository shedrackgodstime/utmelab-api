# utmelab-bank settings. Copy to .env and fill in. Real environment variables win.

# Production Turso database. READ ONLY. This is where the catalog lives
# (subjects, topics, subtopics, objectives). turso db show <db> --url
TURSO_PROD_DATABASE_URL=
# Read only token for the production database.
# turso db tokens create <db> --read-only
TURSO_PROD_AUTH_TOKEN=
# The read-only credential the bank prefers. Keep it separate from the token
# above so a write-capable production credential is never the default.
TURSO_PROD_AUTH_TOKEN_READONLY=

# utmelab-bank's own Turso database. This is where the staging rows live.
# turso db show <db> --url
TURSO_BANK_DATABASE_URL=
# Write token for the bank database.
# turso db tokens create <db>
TURSO_BANK_AUTH_TOKEN=

# GitLab, for pushing the media repository.
GITLAB_TOKEN=

# OCR.space, for extracting text embedded in captured images.
OCR_API_KEY=

# NVIDIA, for the generic OpenAI-compatible provider.
NVIDIA_API_KEY=

# Cloudflare Workers AI accounts used by config/providers/openai.json.
CLOUDFLARE_ACCOUNT_ID_01=
CLOUDFLARE_API_TOKEN_01=
# Add further explicitly authorized accounts only when they are ready.
CLOUDFLARE_ACCOUNT_ID_02=
CLOUDFLARE_API_TOKEN_02=
CLOUDFLARE_ACCOUNT_ID_03=
CLOUDFLARE_API_TOKEN_03=

# OpenRouter is discovery-only until a model and free-tier behavior are tested.
OPENROUTER_API_KEY_01=

# OpenAI-compatible provider settings. The current key is NVIDIA_API_KEY;
# change the base URL and model to use another compatible service.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=
# Optional per-capability overrides. Defaults are selected from the endpoint's
# available models; set these when switching provider or model family.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SECOND_MODEL=

# Optional: point the CLI at an editable config directory instead of the
# packaged copy (useful for local development on an installed package).
# UTMELAB_BANK_CONFIG_DIR=/path/to/utmelab-bank/config
