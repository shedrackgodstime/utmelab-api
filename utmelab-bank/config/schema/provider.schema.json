{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utmelab.com/schemas/provider.schema.json",
  "title": "UTMELab provider manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "secrets",
    "defaults",
    "error_policy",
    "providers",
    "accounts",
    "models",
    "account_selection",
    "observability"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 3},
    "purpose": {"type": "string"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "never_log_values", "never_store_in_this_file"],
      "properties": {
        "source": {"enum": ["environment", "none"]},
        "never_log_values": {"const": true},
        "never_store_in_this_file": {"const": true}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_retries", "max_tokens", "temperature"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_attempts_per_request": {"type": "integer", "minimum": 1},
        "cooldown_seconds": {"type": "number", "minimum": 0},
        "health_probe_before_reenable": {"type": "boolean"}
      }
    },
    "error_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failover_to_next_account", "do_not_failover"],
      "properties": {
        "failover_to_next_account": {"type": "array", "items": {"type": "string"}},
        "do_not_failover": {"type": "array", "items": {"type": "string"}},
        "max_consecutive_failures_before_cooldown": {"type": "integer", "minimum": 1},
        "never_retry_without_a_new_account_or_health_check": {"type": "boolean"}
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["protocol", "status"],
        "properties": {
          "protocol": {"enum": ["openai-compatible", "opencode-cli"]},
          "status": {"enum": ["enabled", "disabled", "discovery_only"]},
          "base_url": {"type": "string"},
          "account_pool": {"type": "string"},
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {"kind": {"enum": ["env", "cli", "none"]}}
          },
          "transport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["http", "cli"]},
              "command": {"type": "string"},
              "args": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "accounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "enabled", "authorized", "priority"],
          "properties": {
            "id": {"type": "string"},
            "api_key_env": {"type": "string"},
            "account_id_env": {"type": "string"},
            "enabled": {"type": "boolean"},
            "authorized": {"type": "boolean"},
            "priority": {"type": "integer"}
          }
        }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["provider", "model_id", "status"],
        "properties": {
          "provider": {"type": "string"},
          "model_id": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "structured_output": {"type": "string"},
          "status": {"type": "string"},
          "observations": {"type": "object"},
          "account_pool": {"type": "string"}
        }
      }
    },
    "account_selection": {"type": "object"},
    "observability": {"type": "object"}
  }
}
