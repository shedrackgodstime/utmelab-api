{
  "$schema": "../schema/provider.schema.json",
  "version": 3,
  "purpose": "Routing for the OpenCode CLI provider family.",
  "secrets": {
    "source": "environment",
    "never_log_values": true,
    "never_store_in_this_file": true
  },
  "defaults": {
    "timeout_seconds": 90,
    "max_retries": 0,
    "max_tokens": 2048,
    "temperature": 0,
    "max_attempts_per_request": 2,
    "cooldown_seconds": 300,
    "health_probe_before_reenable": false
  },
  "error_policy": {
    "failover_to_next_account": ["rate_limit", "quota", "timeout", "provider_unavailable"],
    "do_not_failover": ["authentication", "invalid_request", "input", "output", "schema", "policy", "not_found"],
    "max_consecutive_failures_before_cooldown": 2,
    "never_retry_without_a_new_account_or_health_check": true
  },
  "providers": {
    "opencode": {
      "protocol": "opencode-cli",
      "status": "enabled",
      "account_pool": "opencode-cli",
      "auth": {"kind": "cli"},
      "transport": {
        "kind": "cli",
        "command": "opencode",
        "args": ["run", "--format", "json", "-m", "{model}"]
      }
    }
  },
  "accounts": {
    "opencode-cli": [
      {
        "id": "opencode-local",
        "enabled": true,
        "authorized": true,
        "priority": 10
      }
    ]
  },
  "models": {
    "deepseek-v4.1-flash-free": {
      "provider": "opencode",
      "model_id": "opencode/deepseek-v4.1-flash-free",
      "capabilities": ["text"],
      "structured_output": "json_object",
      "status": "verified_candidate"
    },
    "nemotron-3.5-super-vl-free": {
      "provider": "opencode",
      "model_id": "opencode/nemotron-3.5-super-vl-free",
      "capabilities": ["text", "image_input"],
      "structured_output": "json_object",
      "status": "unstable_candidate"
    },
    "glm-5.3-flash-free": {
      "provider": "opencode",
      "model_id": "opencode/glm-5.3-flash-free",
      "capabilities": ["text", "image_input"],
      "structured_output": "json_object",
      "status": "unstable_candidate"
    }
  },
  "account_selection": {
    "mode": "failover_only",
    "selection_order": "priority_then_health",
    "rotate_on_quota_only": false,
    "rotate_only_on_classified_transient_errors": true,
    "do_not_round_robin_healthy_accounts": true,
    "reserve_unknown_quota": true,
    "persist_health_outside_git": true
  },
  "observability": {
    "record_per_attempt": ["provider", "account_id", "model_id", "task", "started_at", "latency_ms", "status", "error_category"],
    "never_record": ["api_key", "auth_token", "raw_prompt", "raw_image_bytes", "raw_provider_response"]
  }
}
