---
import ThemeToggle from '@utmelab/ui/components/ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const navLinks = [
  { label: 'Catalog', href: '#catalog' },
  { label: 'Documentation', href: '/docs/' },
  { label: 'API Reference', href: '/docs/' },
  { label: 'Pricing', href: '#pricing' },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-surface/80 backdrop-blur-md transition-colors">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <!-- Brand Identity -->
    <div class="flex items-center gap-8">
      <a href="/" class="group flex items-center gap-2.5 focus-visible:outline-none" aria-label="UTME Lab home">
        <span class="flex size-8 items-center justify-center rounded-brand bg-accent text-accent-ink shadow-xs transition-transform group-hover:scale-105">
          <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
            <path d="M6.5 14v4a2 2 0 0 0 2 2H14" />
          </svg>
        </span>
        <span class="flex items-center gap-1.5 font-semibold tracking-tight text-ink text-base">
          <span>UTME</span><span class="text-accent font-bold">Lab</span>
          <span class="rounded-full border border-hairline bg-surface-2 px-1.5 py-0.2 font-mono text-[10px] text-muted">API</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-body" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-brand px-3 py-1.5 text-body hover:text-ink hover:bg-surface-2 transition-all"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Desktop Action Buttons -->
    <div class="hidden md:flex items-center gap-3">
      <ThemeToggle />
      <div class="h-4 w-px bg-hairline" aria-hidden="true"></div>
      <a
        href="/auth/signin/"
        class="rounded-brand px-3 py-1.5 text-sm font-medium text-body hover:text-ink hover:bg-surface-2 transition-all"
      >
        Sign in
      </a>
      <a
        href="/auth/signup/"
        class="inline-flex items-center justify-center rounded-brand bg-accent px-3.5 py-1.5 text-sm font-medium text-accent-ink hover:bg-accent-hover transition-colors shadow-xs"
      >
        Get API key
      </a>
    </div>

    <!-- Mobile Hamburger and Actions -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="mobile-nav-toggle"
        class="inline-flex size-9 items-center justify-center rounded-brand border border-hairline bg-surface text-ink hover:bg-surface-2 hover:border-muted transition-colors focus-visible:outline-none"
        aria-controls="mobile-nav-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger Icon -->
        <svg id="icon-open" class="size-5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <!-- Close Icon -->
        <svg id="icon-close" class="size-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden fixed inset-x-0 top-16 border-b border-hairline bg-surface/95 backdrop-blur-xl shadow-xl transition-all"
  >
    <div class="px-6 py-5 space-y-4 max-h-[calc(100vh-4rem)] overflow-y-auto">
      <nav class="space-y-1" aria-label="Mobile navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link block rounded-brand px-3 py-2.5 text-base font-medium text-ink hover:bg-surface-2 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="border-t border-hairline pt-4 space-y-2.5">
        <a
          href="/auth/signin/"
          class="mobile-nav-link block w-full text-center rounded-brand border border-hairline bg-surface py-2.5 text-sm font-medium text-ink hover:bg-surface-2 transition-colors"
        >
          Sign in
        </a>
        <a
          href="/auth/signup/"
          class="mobile-nav-link block w-full text-center rounded-brand bg-accent py-2.5 text-sm font-medium text-accent-ink hover:bg-accent-hover transition-colors shadow-xs"
        >
          Get API key
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (!menu || !toggleBtn || !iconOpen || !iconClose) return;
    menu.classList.remove('hidden');
    iconOpen.classList.add('hidden');
    iconOpen.classList.remove('block');
    iconClose.classList.remove('hidden');
    iconClose.classList.add('block');
    toggleBtn.setAttribute('aria-expanded', 'true');
    toggleBtn.setAttribute('aria-label', 'Close navigation menu');
  }

  function closeMenu() {
    if (!menu || !toggleBtn || !iconOpen || !iconClose) return;
    menu.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconOpen.classList.add('block');
    iconClose.classList.add('hidden');
    iconClose.classList.remove('block');
    toggleBtn.setAttribute('aria-expanded', 'false');
    toggleBtn.setAttribute('aria-label', 'Open navigation menu');
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
    }
  });

  document.addEventListener('click', (e) => {
    if (!menu?.classList.contains('hidden')) {
      const target = e.target as Node;
      if (!menu.contains(target) && !toggleBtn?.contains(target)) {
        closeMenu();
      }
    }
  });
</script>
