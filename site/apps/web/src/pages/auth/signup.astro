---
import AuthShell from '../../layouts/AuthShell.astro';
---

<AuthShell title="Create account" description="Create your UTME Lab developer account.">
  <div class="w-full max-w-md rounded-brand border border-hairline bg-surface p-8 shadow-sm space-y-6">
    <div class="space-y-1.5 text-center">
      <h1 class="text-xl font-semibold tracking-tight text-ink">Create developer account</h1>
      <p class="text-xs text-body">Start building with 1,000 free questions monthly. No card required.</p>
    </div>

    <form class="space-y-4" data-auth-form>
      <div class="space-y-1.5">
        <label for="name" class="text-xs font-medium text-ink">Full name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          placeholder="Ada Lovelace"
          class="w-full rounded-brand-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        />
      </div>

      <div class="space-y-1.5">
        <label for="email" class="text-xs font-medium text-ink">Work email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="developer@company.com"
          class="w-full rounded-brand-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        />
      </div>

      <div class="space-y-1.5">
        <label for="password" class="text-xs font-medium text-ink">Password (minimum 8 characters)</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          required
          minlength="8"
          placeholder="••••••••"
          class="w-full rounded-brand-sm border border-hairline bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        />
      </div>

      <p class="text-[11px] text-muted leading-relaxed text-center">
        By clicking create account, you agree to our
        <a href="/docs/terms/" class="text-accent hover:underline">Terms of Service</a> and
        <a href="/docs/privacy/" class="text-accent hover:underline">Privacy Policy</a>.
      </p>

      <button
        type="submit"
        class="w-full rounded-brand bg-accent py-2.5 text-sm font-medium text-accent-ink hover:bg-accent-hover transition-colors shadow-xs"
      >
        Create account
      </button>
    </form>

    <div class="border-t border-hairline pt-4 text-center text-xs text-muted">
      <span>Already have an account?</span>
      <a href="/auth/signin/" class="ml-1 font-medium text-accent hover:underline">Sign in</a>
    </div>
  </div>
</AuthShell>

<script>
  const form = document.querySelector('form[data-auth-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.location.href = '/auth/verify-email/';
  });
</script>
