---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="UTME Lab — The West African exam API"
  description="Structured JAMB, WAEC and NECO content over one API — questions, answers, explanations, syllabi and paper assembly. More exams joining soon."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 grid gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
      <!-- Copy -->
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-hairline bg-surface px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
          <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          The West African exam API
        </p>

        <h1 class="mt-6 text-display-xl font-semibold text-ink max-w-[16ch]">
          Every exam question. <span class="text-accent">One API.</span>
        </h1>

        <p class="mt-6 text-lg text-body max-w-[44ch] leading-relaxed">
          Structured JAMB, WAEC and NECO content over a fast, documented REST
          API — questions, answers, explanations, syllabi and full-paper
          assembly. Stop compiling banks. Start shipping.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/auth/signup/"
             class="inline-flex items-center justify-center rounded-brand bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink hover:bg-accent-hover transition-colors shadow-xs">
            Create free account
          </a>
          <a href="/docs/guides/quickstart/"
             class="inline-flex items-center justify-center rounded-brand border border-hairline bg-surface px-5 py-2.5 text-sm font-medium text-ink hover:border-muted hover:bg-surface-2 transition-colors">
            Quickstart in 60s
          </a>
        </div>
        <p class="mt-3 font-mono text-xs text-muted">1,000 free questions monthly · No card required</p>

        <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-hairline pt-6 max-w-md">
          <div>
            <dt class="order-2 mt-1 text-xs text-muted">Questions in the bank</dt>
            <dd class="font-mono text-2xl font-semibold tracking-tight text-ink">2,244</dd>
          </div>
          <div>
            <dt class="order-2 mt-1 text-xs text-muted">JAMB subjects live</dt>
            <dd class="font-mono text-2xl font-semibold tracking-tight text-ink">25<span class="text-muted">/25</span></dd>
          </div>
          <div>
            <dt class="order-2 mt-1 text-xs text-muted">WAEC countries</dt>
            <dd class="font-mono text-2xl font-semibold tracking-tight text-ink">5</dd>
          </div>
        </dl>
      </div>

      <!-- Coverage grid -->
      <div>
        <div class="rounded-brand border border-hairline bg-surface p-6 shadow-xl">
          <div class="flex items-center justify-between gap-3">
            <p class="font-medium text-ink">Exam coverage</p>
            <p class="font-mono text-[11px] text-muted">Live counts from the bank</p>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="rounded-brand border border-hairline bg-canvas p-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-ink">JAMB</span>
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-emerald-500"></span>LIVE</span>
              </div>
              <p class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">25<span class="text-sm text-muted">/25</span></p>
              <p class="mt-1 text-xs text-muted">subjects · 2,244 questions</p>
            </div>
            <div class="rounded-brand border border-hairline bg-canvas p-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-ink">WAEC</span>
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-emerald-500"></span>LIVE</span>
              </div>
              <p class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">5</p>
              <p class="mt-1 text-xs text-muted">countries · split syllabi</p>
            </div>
            <div class="rounded-brand border border-hairline bg-canvas p-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-ink">NECO</span>
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-success"><span class="size-1.5 rounded-full bg-emerald-500"></span>LIVE</span>
              </div>
              <p class="mt-2 font-mono text-2xl font-semibold tracking-tight text-ink">3</p>
              <p class="mt-1 text-xs text-muted">subjects catalogued</p>
            </div>
            <div class="rounded-brand border border-dashed border-hairline bg-canvas p-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm font-semibold text-muted">POST-UTME</span>
                <span class="font-mono text-[10px] text-muted">PLANNED</span>
              </div>
              <p class="mt-2 font-mono text-2xl font-semibold tracking-tight text-muted">…</p>
              <p class="mt-1 text-xs text-muted">screening prep · in the works</p>
            </div>
          </div>

          <p class="mt-5 border-t border-hairline pt-4 font-mono text-[11px] text-muted">More exams joining soon — this grid grows, never rewrites.</p>
        </div>
        <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px] text-muted">
          <span><span class="text-success">✓</span> Live means servable today</span>
          <span><span class="text-success">✓</span> Planned means planned, not soon</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ API SURFACE ============ -->
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="max-w-[52ch]">
      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">API surface</p>
      <h2 class="mt-3 text-display-lg font-semibold tracking-tight text-ink">The whole bank, behind one key.</h2>
      <p class="mt-3 text-body leading-relaxed">Every route below is live in production and generated into the OpenAPI reference. No scraping, no screens — just calls.</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-brand border border-hairline bg-surface p-6">
        <h3 class="font-medium text-ink">Questions</h3>
        <p class="mt-1 text-sm text-muted">Filter, page, and fetch — answers withheld unless you ask.</p>
        <ul class="mt-4 space-y-2 font-mono text-[13px]">
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/questions</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/questions/&#123;id&#125;</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-warning">POST</span><span class="text-body">/v1/questions/&#123;id&#125;/report</span></li>
        </ul>
      </div>
      <div class="rounded-brand border border-hairline bg-surface p-6">
        <h3 class="font-medium text-ink">Papers</h3>
        <p class="mt-1 text-sm text-muted">Seeded assembly, server-side scoring — answers never ride the wire.</p>
        <ul class="mt-4 space-y-2 font-mono text-[13px]">
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-warning">POST</span><span class="text-body">/v1/papers/&#123;exam&#125;/&#123;subject&#125;</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-warning">POST</span><span class="text-body">/v1/papers/&#123;exam&#125;/&#123;subject&#125;/score</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/exams/&#123;exam&#125;/papers</span></li>
        </ul>
      </div>
      <div class="rounded-brand border border-hairline bg-surface p-6">
        <h3 class="font-medium text-ink">Syllabus</h3>
        <p class="mt-1 text-sm text-muted">Catalog, topic trees with live counts, and measured readiness.</p>
        <ul class="mt-4 space-y-2 font-mono text-[13px]">
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/exams · /v1/exams/&#123;exam&#125;/subjects</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/subjects/&#123;exam&#125;/&#123;slug&#125;&#123;/syllabus, /coverage&#125;</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/topics/… · /v1/blueprints/&#123;exam&#125;/&#123;subject&#125;</span></li>
        </ul>
      </div>
      <div class="rounded-brand border border-hairline bg-surface p-6">
        <h3 class="font-medium text-ink">Texts</h3>
        <p class="mt-1 text-sm text-muted">Set novels with questions, plus shared passages.</p>
        <ul class="mt-4 space-y-2 font-mono text-[13px]">
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/novels · /v1/novels/&#123;id&#125;&#123;/questions&#125;</span></li>
          <li class="flex items-center gap-3"><span class="w-11 shrink-0 font-semibold text-success">GET</span><span class="text-body">/v1/passages/&#123;id&#125;</span></li>
        </ul>
        <a href="/docs/" class="mt-4 inline-block text-sm font-medium text-accent hover:underline">Full reference in the docs →</a>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="flex flex-col items-start justify-between gap-5 rounded-brand border border-hairline bg-surface px-6 py-8 sm:flex-row sm:items-center md:px-10">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-ink">Start building tonight.</h2>
        <p class="mt-1 text-sm text-body">1,000 free questions monthly. No card required.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/auth/signup/" class="inline-flex items-center justify-center rounded-brand bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink hover:bg-accent-hover transition-colors shadow-xs">Get your API key</a>
        <a href="/docs/guides/quickstart/" class="inline-flex items-center justify-center rounded-brand border border-hairline bg-surface px-5 py-2.5 text-sm font-medium text-ink hover:border-muted transition-colors">Quickstart</a>
      </div>
    </div>
  </section>

</MarketingLayout>

<style>
  .hero-glow {
    position: absolute;
    top: -10rem;
    left: 50%;
    height: 22rem;
    width: 44rem;
    max-width: 100vw;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.12;
    filter: blur(96px);
    pointer-events: none;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, black 25%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }
</style>
