---
// Auth shell — a centred card, deliberately NOT the dashboard shell. Signed-out
// users have no sidebar because there is no account to navigate yet.
// Placeholder only: nothing posts anywhere. See §Auth in the repo handoff.
import '../styles/dashboard.css';

interface Props {
	title: string;
	subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="utmelab">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — UTME Lab</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body class="grid min-h-screen place-items-center bg-base-200 p-6">
		<main class="w-full max-w-sm">
			<div class="mb-6 text-center">
				<a href="/" class="text-lg font-semibold no-underline">UTME Lab</a>
			</div>

			<div class="card bg-base-100 shadow-sm">
				<div class="card-body">
					<h1 class="card-title text-xl">{title}</h1>
					<p class="text-sm text-base-content/70">{subtitle}</p>
					<slot />
				</div>
			</div>

			<p class="mt-6 text-center text-sm text-base-content/60">
				<a href="/" class="link link-hover">← Back to the site</a>
			</p>
		</main>
	</body>
</html>