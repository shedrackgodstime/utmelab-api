---
// Dashboard shell. Deliberately unbuilt: the sidebar and the routes exist so
// the structure is decided and the design blocks are proven, not so the product
// is decided. Every panel below is a placeholder — see docs/DASHBOARD.md.
//
// Styling comes from daisyUI via dashboard.css, imported HERE so it loads only
// for dashboard routes and can never repaint the Starlight docs.
import '../styles/dashboard.css';

interface Props {
	title: string;
	active: 'overview' | 'api-key' | 'billing';
}

const { title, active } = Astro.props;

const nav = [
	{ id: 'overview', label: 'Overview', href: '/dashboard/' },
	{ id: 'api-key', label: 'API key', href: '/dashboard/api-key/' },
	{ id: 'billing', label: 'Billing & account', href: '/dashboard/billing/' },
] as const;
---

<!doctype html>
<html lang="en" data-theme="utmelab">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — UTME Lab</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body class="min-h-screen bg-base-200">
		<div class="drawer lg:drawer-open">
			<input id="dash-drawer" type="checkbox" class="drawer-toggle" />

			<div class="drawer-content flex min-h-screen flex-col">
				<header
					class="navbar sticky top-0 z-10 border-b border-base-300 bg-base-100 lg:hidden"
				>
					<label for="dash-drawer" aria-label="Open navigation" class="btn btn-ghost btn-square">
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<path d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</label>
					<span class="text-base font-semibold">{title}</span>
				</header>

				<main class="mx-auto w-full max-w-5xl flex-1 p-6 lg:p-10">
					<h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
					<slot />
				</main>
			</div>

			<div class="drawer-side z-20">
				<label for="dash-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
				<aside class="flex min-h-full w-72 flex-col border-r border-base-300 bg-base-100">
					<div class="flex h-16 items-center gap-2 border-b border-base-300 px-5">
						<a href="/" class="link-hover text-base font-semibold no-underline">UTME Lab</a>
						<span class="badge badge-ghost badge-sm">dashboard</span>
					</div>

					<ul class="menu w-full flex-1 gap-1 p-3">
						{nav.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={item.id === active ? 'page' : undefined}
									class={item.id === active ? 'menu-active' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>

					<div class="border-t border-base-300 p-3">
						<a href="/" class="btn btn-ghost btn-sm w-full justify-start">← Back to the site</a>
					</div>
				</aside>
			</div>
		</div>
	</body>
</html>