---
/**
 * Verbatim copy of @astrojs/starlight@0.42.6 dist/components/Header.astro
 * with two additions: a site nav (Documentation, Dashboard) and an auth
 * action. Review on bump.
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { LinkButton } from '@astrojs/starlight/components';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const id = Astro.locals.starlightRoute?.id ?? '';
const inDashboard = id === 'dashboard' || id.startsWith('dashboard/');
const dashboardSection =
	id === 'dashboard'
		? 'Overview'
		: id === 'dashboard/api-key'
			? 'API key'
			: id === 'dashboard/billing'
				? 'Billing & account'
				: '';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		{inDashboard ? (
			<h1 class="dash-section-title">{dashboardSection}</h1>
		) : (
			<SiteTitle />
		)}
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	{/* One public header everywhere: the auth action only. The dashboard
	    frame hides it (authenticated surface); a user menu takes that
	    slot when auth lands. */}
	{!inDashboard && (
		<nav class="site-nav sl-flex print:hidden" aria-label="Site">
			{/* AUTH PLACEHOLDER: no session yet. Public surfaces render Sign in.
			    A real LinkButton — the theme owns its metrics. */}
			<LinkButton href="/signin/">Sign in</LinkButton>
		</nav>
	)}
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			/* One flow on mobile: the title absorbs free space so search
			   and nav cluster right instead of stranding search center. */
			flex: 1 1 auto;
		}

		/* Dashboard section title: the header's own voice on dashboard
		   routes — brand stays in the sidebar. */
		.dash-section-title {
			margin: 0;
			font-size: 1rem;
			font-weight: 500;
			white-space: nowrap;
		}

		.site-nav {
			display: flex;
			align-items: center;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
        /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest  */
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					/* 2 (search box): all free space that is available. */
					1fr
					/* 3 (site nav + account action): use the space that they need. */
					auto
					/* 4 (appearance): use the space that these need. */
					auto;
				align-content: center;
			}
		}
	}
</style>

<style>
	/* Header sign-in: LinkButton metrics are built for heroes (pill, roomy).
	   In the header it goes compact and less round. Unlayered so it beats
	   Starlight's components-layer button rules; scoped to the nav so
	   content LinkButtons are untouched. */
	.site-nav .sl-link-button {
		font-size: var(--sl-text-sm);
		padding: 0.375rem 0.875rem;
		border-radius: 0.5rem;
	}

	@media (min-width: 50rem) {
		.site-nav .sl-link-button {
			font-size: var(--sl-text-sm);
			padding: 0.375rem 0.875rem;
		}
	}
</style>
