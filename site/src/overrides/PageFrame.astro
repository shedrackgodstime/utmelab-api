---
// Frame switch. Docs/landing delegate to Starlight untouched; dashboard
// routes wrap the SAME frame in .dash-frame so scoped geometry (full-height
// sidebar, offset header) applies without touching Starlight globally.
import Default from '@astrojs/starlight/components/PageFrame.astro';

const id = Astro.locals.starlightRoute?.id ?? '';
const isDashboard = id === 'dashboard' || id.startsWith('dashboard/');
const isAuth = id === 'signin' || id === 'signup' || id === 'reset-password' || id === 'verify-email';
---

{
	isDashboard ? (
		<div class="dash-frame">
			<span hidden data-pagefind-filter="section:dashboard" />
			<Default>
				<slot name="header" slot="header" />
				<slot name="sidebar" slot="sidebar" />
				<slot />
			</Default>
		</div>
	) : isAuth ? (
		<div class="auth-frame">
			<slot />
		</div>
	) : (
		<>
			<span hidden data-pagefind-filter="section:docs" />
			<Default>
				<slot name="header" slot="header" />
				<slot name="sidebar" slot="sidebar" />
				<slot />
			</Default>
		</>
	)
}
