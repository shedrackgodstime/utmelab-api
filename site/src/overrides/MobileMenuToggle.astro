---
// Menu button switch. Docs keep Starlight's floating bars button;
// dashboard gets the shadcn grammar: a ghost square button with a
// PanelLeft icon that morphs to X while the drawer is open.
// Same popover target, so Starlight's drawer mechanics are untouched.
// On desktop the same button collapses the sidebar instead (Starlight
// itself disables the popover there).
import Default from '@astrojs/starlight/components/MobileMenuToggle.astro';

const id = Astro.locals.starlightRoute?.id ?? '';
const isDashboard = id === 'dashboard' || id.startsWith('dashboard/');
---

{
	isDashboard ? (
		<>
			<button
				id="dash-menu-button"
				popovertarget="starlight__sidebar"
				class="dash-menu-button"
				aria-label={Astro.locals.t('menuButton.accessibleLabel')}
			>
				<svg
					class="dash-icon-panel"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect width="18" height="18" x="3" y="3" rx="2" />
					<path d="M9 3v18" />
				</svg>
				<svg
					class="dash-icon-close"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</svg>
				<span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
			</button>
			<script>
				const root = document.documentElement;
				try {
					if (sessionStorage.getItem('dash-collapsed') === '1') {
						root.classList.add('dash-collapsed');
					}
				} catch {}
				document.getElementById('dash-menu-button')?.addEventListener('click', (e) => {
					// Mobile: let Starlight's popover drawer handle it.
					if (!matchMedia('(min-width: 50rem)').matches) return;
					e.preventDefault();
					const collapsed = root.classList.toggle('dash-collapsed');
					try {
						sessionStorage.setItem('dash-collapsed', collapsed ? '1' : '0');
					} catch {}
				});
			</script>
		</>
	) : (
		<Default />
	)
}

<style>
	.dash-menu-button {
		position: fixed;
		top: calc((var(--sl-nav-height) - 2rem) / 2);
		inset-inline-start: var(--sl-nav-pad-x);
		z-index: calc(var(--sl-z-index-navbar) + 2);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: 0.375rem;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.dash-menu-button:hover {
		background-color: var(--sl-color-hairline-shade);
	}

	.dash-menu-button:has(~ :popover-open) .dash-icon-panel {
		display: none;
	}

	.dash-menu-button:not(:has(~ :popover-open)) .dash-icon-close {
		display: none;
	}

	@media (min-width: 50rem) {
		.dash-menu-button {
			inset-inline-start: calc(var(--sl-sidebar-width) + var(--sl-nav-pad-x));
			transition: inset-inline-start 0.2s ease;
		}

		:global(html.dash-collapsed) .dash-menu-button {
			inset-inline-start: var(--sl-nav-pad-x);
		}
	}
</style>
