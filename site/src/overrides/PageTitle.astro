---
// Title switch. Docs keep the large docs heading; dashboard and auth
// pages carry their own titles (header section title, auth card), so the
// docs title never renders there.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const id = Astro.locals.starlightRoute?.id ?? '';
const isDashboard = id === 'dashboard' || id.startsWith('dashboard/');
const isAuth = id === 'signin' || id === 'signup' || id === 'reset-password' || id === 'verify-email';
---

{isDashboard || isAuth ? null : <Default />}
