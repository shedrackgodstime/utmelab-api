---
// The dashboard. A static shell: it ships as files and holds no data of its
// own. After sign-in the browser fetches /internal/v1/* itself, so no server
// process is required to render this page.
const sections = [
	{ title: 'Your API key', note: 'Create, rotate and revoke the key your integration sends in X-API-Key.' },
	{ title: 'Usage', note: 'Requests per minute against your allowance, and what you have drawn down this month.' },
	{ title: 'Billing', note: 'Plan, invoices and payment method.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dashboard — UTME Lab</title>
		<meta name="description" content="Your API key, usage and billing." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<header>
			<a class="brand" href="/">UTME Lab</a>
			<nav>
				<a href="/docs/">Docs</a>
				<a href="/dashboard/" aria-current="page">Dashboard</a>
			</nav>
		</header>

		<main>
			<h1>Dashboard</h1>
			<p class="lede">Not built yet. This page will hold:</p>

			<ul class="sections">
				{
					sections.map((s) => (
						<li>
							<h2>{s.title}</h2>
							<p>{s.note}</p>
						</li>
					))
				}
			</ul>

			<!-- Populated from /internal/v1/me once sign-in exists. -->
			<div id="account" hidden></div>

			<p class="note">
				In the meantime, the <a href="/docs/">documentation</a> and the
				<a href="/docs/api/">API reference</a> are live.
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		--accent: #0f766e;
		--ink: #1c1917;
		--muted: #57534e;
		--line: #e7e5e4;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--ink: #fafaf9;
			--muted: #a8a29e;
			--line: #292524;
			--accent: #2dd4bf;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		color: var(--ink);
		background: Canvas;
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		line-height: 1.6;
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 52rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}
	.brand {
		font-weight: 650;
		color: var(--ink);
		text-decoration: none;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		margin-left: 1.25rem;
	}
	nav a[aria-current] {
		color: var(--accent);
	}
	main {
		max-width: 52rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
	}
	h1 {
		font-size: 2.25rem;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem;
	}
	.lede {
		color: var(--muted);
	}
	.sections {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.sections li {
		padding: 1.125rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
	}
	.sections h2 {
		font-size: 1rem;
		margin: 0 0 0.25rem;
		letter-spacing: -0.01em;
	}
	.sections p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.note {
		margin-top: 2.5rem;
		color: var(--muted);
	}
	.note a {
		color: var(--accent);
	}
</style>