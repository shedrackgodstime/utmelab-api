---
import Dashboard from '../../layouts/Dashboard.astro';
---

<Dashboard title="Overview" active="overview">
	<div class="alert alert-info mt-6">
		<span>
			Scaffold only. The panels below are daisyUI blocks wired to nothing — no
			<code class="font-mono">/internal/v1/*</code> endpoint exists yet
			(<a class="link" href="/docs/">D33</a>).
		</span>
	</div>

	<div class="stats stats-vertical mt-6 w-full bg-base-100 shadow-sm sm:stats-horizontal">
		<div class="stat">
			<div class="stat-title">Requests this month</div>
			<div class="stat-value text-primary">—</div>
			<div class="stat-desc">Not wired</div>
		</div>
		<div class="stat">
			<div class="stat-title">Rate limit</div>
			<div class="stat-value">—</div>
			<div class="stat-desc">per minute</div>
		</div>
		<div class="stat">
			<div class="stat-title">Plan</div>
			<div class="stat-value text-2xl">—</div>
			<div class="stat-desc">Billing not wired</div>
		</div>
	</div>

	<div class="card mt-6 bg-base-100 shadow-sm">
		<div class="card-body">
			<h2 class="card-title">What replaces the placeholders</h2>
			<ul class="list-inside list-disc text-sm text-base-content/70">
				<li>Real figures from <code class="font-mono">/internal/v1/usage</code>.</li>
				<li>
					A plan name from <code class="font-mono">/internal/v1/me</code>, or a link to
					<a href="/dashboard/billing/">Billing</a> on the free tier.
				</li>
				<li>Remove this alert once the first endpoint lands.</li>
			</ul>
		</div>
	</div>
</Dashboard>
