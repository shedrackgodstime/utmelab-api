---
import Auth from '../../layouts/Auth.astro';
---

<Auth title="Create an account" subtitle="Start on the free tier — the catalog needs no key.">
	<form class="mt-4 flex flex-col gap-3">
		<label class="form-control">
			<span class="label-text mb-1">Email</span>
			<input
				type="email"
				name="email"
				autocomplete="email"
				placeholder="you@example.com"
				class="input input-bordered w-full"
			/>
		</label>

		<label class="form-control">
			<span class="label-text mb-1">Password</span>
			<input
				type="password"
				name="password"
				autocomplete="new-password"
				placeholder="••••••••"
				class="input input-bordered w-full"
			/>
		</label>

		<p class="text-xs text-base-content/60">
			12 characters or more. Length beats punctuation.
		</p>

		<button type="submit" class="btn btn-primary mt-2 w-full">Create account</button>
	</form>

	<p class="mt-4 text-center text-sm text-base-content/70">
		Already have one?
		<a href="/signin/" class="link">Sign in</a>
	</p>
</Auth>