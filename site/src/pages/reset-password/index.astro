---
import Auth from '../../layouts/Auth.astro';
---

<Auth
	title="Reset password"
	subtitle="We'll email you a link. If the address is not ours, nothing happens."
>
	<form class="mt-4 flex flex-col gap-3">
		<label class="form-control">
			<span class="label-text mb-1">Email</span>
			<input
				type="email"
				name="email"
				autocomplete="email"
				placeholder="you@example.com"
				class="input input-bordered w-full"
			/>
		</label>

		<button type="submit" class="btn btn-primary w-full">Send reset link</button>
	</form>

	<div class="alert mt-4 text-sm">
		<span>
			We answer the same way whether or not the address exists — otherwise this page
			tells you who has an account.
		</span>
	</div>

	<p class="mt-4 text-center text-sm text-base-content/70">
		<a href="/signin/" class="link">Back to sign in</a>
	</p>
</Auth>