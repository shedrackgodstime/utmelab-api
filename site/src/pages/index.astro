---
// The landing page. It lives outside Starlight's /docs so the two do not
// compete for the same route. Starlight's catch-all would happily answer /,
// but an explicit page wins and is the honest place for marketing copy.
const calls = [
	{
		label: 'List exams',
		note: 'Free, no key needed',
		cmd: 'curl https://api.utmelab.com/api/v1/exams',
	},
	{
		label: 'WAEC subjects',
		note: 'Free, no key needed',
		cmd: "curl https://api.utmelab.com/api/v1/exams/WAEC/subjects",
	},
	{
		label: 'Check your key',
		note: 'Needs X-API-Key',
		cmd: 'curl https://api.utmelab.com/api/v1/keys/me -H "X-API-Key: $UTMELAB_API_KEY"',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>UTME Lab API</title>
		<meta
			name="description"
			content="JAMB, WAEC and NECO past questions, syllabus and answers, keyed to subtopics."
		/>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<header>
			<a class="brand" href="/">UTME Lab</a>
			<nav>
				<a href="/docs/">Docs</a>
				<a href="/docs/api/">Reference</a>
				<a href="/dashboard/">Dashboard</a>
			</nav>
		</header>

		<main>
			<h1>Past questions, keyed to subtopics.</h1>
			<p class="lede">
				Every UTME candidate writes Use of English plus three other subjects. This is
				the question bank behind that exam — JAMB, WAEC and NECO — with the syllabus it is
				drawn from.
			</p>
			<p class="cta">
				<a class="button" href="/docs/guides/authentication/">Get an API key</a>
				<a class="button ghost" href="/docs/">Read the docs</a>
			</p>

			<h2>Try it now</h2>
			<p class="note">The catalog is free and unauthenticated. No signup to see it work.</p>
			<ul class="calls">
				{
					calls.map((c) => (
						<li>
							<div class="call-head">
								<strong>{c.label}</strong>
								<span>{c.note}</span>
							</div>
							<pre><code>{c.cmd}</code></pre>
						</li>
					))
				}
			</ul>
		</main>

		<footer>
			<a href="/docs/">Documentation</a>
			<a href="/docs/api/">API reference</a>
			<a href="/dashboard/">Dashboard</a>
		</footer>
	</body>
</html>

<style>
	:root {
		--accent: #0f766e;
		--ink: #1c1917;
		--muted: #57534e;
		--line: #e7e5e4;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--ink: #fafaf9;
			--muted: #a8a29e;
			--line: #292524;
			--accent: #2dd4bf;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		color: var(--ink);
		background: Canvas;
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		line-height: 1.6;
	}
	header,
	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 52rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}
	.brand {
		font-weight: 650;
		color: var(--ink);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	nav a,
	footer a {
		color: var(--muted);
		text-decoration: none;
		margin-left: 1.25rem;
	}
	nav a:hover,
	footer a:hover {
		color: var(--accent);
	}
	main {
		max-width: 52rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
	}
	h1 {
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
	}
	h2 {
		font-size: 1.25rem;
		margin: 3rem 0 0.5rem;
		letter-spacing: -0.01em;
	}
	.lede {
		font-size: 1.125rem;
		color: var(--muted);
		max-width: 40rem;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0 0;
	}
	.button {
		display: inline-block;
		padding: 0.625rem 1.125rem;
		border-radius: 0.5rem;
		background: var(--accent);
		color: #fff;
		font-weight: 550;
		text-decoration: none;
	}
	@media (prefers-color-scheme: dark) {
		.button {
			color: #042f2e;
		}
	}
	.button.ghost {
		background: transparent;
		color: var(--ink);
		box-shadow: inset 0 0 0 1px var(--line);
	}
	.note {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.calls {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.call-head {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		margin-bottom: 0.5rem;
	}
	.call-head span {
		color: var(--muted);
		font-size: 0.8125rem;
	}
	pre {
		margin: 0;
		padding: 0.875rem 1rem;
		background: color-mix(in srgb, var(--ink) 5%, transparent);
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		overflow-x: auto;
	}
	code {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.8125rem;
	}
	footer {
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.875rem;
	}
	footer a:first-child {
		margin-left: 0;
	}
</style>