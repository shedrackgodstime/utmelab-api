---
// Site-wide navigation for the docs. Starlight's own Header has no slots, so
// it cannot host extra links — this is a faithful rebuild with a nav row added
// between the site title and the search box. The fixed-height bar and its grid
// come from Starlight's PageFrame, so only the inner row is ours.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

// `starlightRoute` is populated by Starlight's middleware on every docs page,
// including overridden components. Its `id` is the content collection id —
// e.g. `docs/api/operations/listquestions` — with no leading slash.
// (`entry.path` is always `/`, so it cannot be used for matching.)
const id = Astro.locals.starlightRoute?.id ?? 'docs';
const inReference = id === 'docs/api' || id.startsWith('docs/api/');
const inDocs = id === 'docs' || id.startsWith('docs/');

const links = [
	{ href: '/docs/', label: 'Docs', active: inDocs && !inReference },
	{ href: '/docs/api/', label: 'Reference', active: inReference },
	{ href: '/dashboard/', label: 'Dashboard', active: false },
];
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>

	<nav class="site-nav sl-hidden md:sl-flex print:hidden" aria-label="Site">
		{
			links.map((l) => (
				<a href={l.href} aria-current={l.active ? 'page' : undefined}>
					{l.label}
				</a>
			))
		}
	</nav>

	<div class="sl-flex print:hidden">
		<Search />
	</div>

	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.site-nav {
			gap: 0.25rem;
			margin-inline-start: auto;
		}

		.site-nav a {
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			text-decoration: none;
			padding: 0.25rem 0.5rem;
			border-radius: 0.375rem;
			white-space: nowrap;
		}

		.site-nav a:hover {
			color: var(--sl-color-white);
			background: var(--sl-color-gray-5);
		}

		.site-nav a[aria-current] {
			color: var(--sl-color-white);
			background: var(--sl-color-gray-6);
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, 0rem) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--__nav-gap))),
						auto
					)
					1fr auto;
				align-content: center;
			}
		}
	}
</style>