---
// Centered auth card. Splash pages only. Scoped styles, --sl-* vars.
interface Props {
	title: string;
	subtitle: string;
	hideBack?: boolean;
}

const { title, subtitle, hideBack = false } = Astro.props;
---

<div class="auth-wrap">
	<div class="auth-col">
		{!hideBack && (
			<p class="auth-back">
				<a href="/">← Back to home</a>
			</p>
		)}
		<div class="auth-card">
			<h1 class="auth-title">{title}</h1>
			<p class="auth-subtitle">{subtitle}</p>
			<slot />
		</div>
	</div>
</div>

<style>
	.auth-wrap {
		display: grid;
		place-items: center;
		padding: 3rem 1rem;
	}

	.auth-col {
		width: 100%;
		max-width: 24rem;
	}

	.auth-back {
		display: flex;
		gap: 1.25rem;
		margin: 0 0 1rem;
		font-size: var(--sl-text-sm);
	}

	.auth-back a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.auth-back a:hover {
		color: var(--sl-color-text-accent);
	}

	.auth-card {
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		padding: 1.5rem;
		box-shadow: var(--sl-shadow-md);
	}

	.auth-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	.auth-subtitle {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: 1.6;
	}
</style>
