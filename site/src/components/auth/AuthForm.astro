---
// Auth form. Visual only — no backend wired, submit is intercepted.
// Fields switch by mode; footer links switch between the three pages.
interface Props {
	mode: 'signin' | 'signup' | 'reset';
}

const { mode } = Astro.props;

const submitLabel =
	mode === 'signin' ? 'Sign in' : mode === 'signup' ? 'Create account' : 'Send reset link';
---

<form class="auth-form" data-auth-form>
	{
		mode === 'signup' && (
			<div class="auth-field">
				<label for="auth-name">Full name</label>
				<input id="auth-name" name="name" type="text" autocomplete="name" required />
			</div>
		)
	}
	<div class="auth-field">
		<label for="auth-email">Email</label>
		<input id="auth-email" name="email" type="email" autocomplete="email" required />
	</div>
	{
		mode !== 'reset' && (
			<div class="auth-field">
				<label for="auth-password">Password</label>
				<input
					id="auth-password"
					name="password"
					type="password"
					autocomplete={mode === 'signin' ? 'current-password' : 'new-password'}
					required
				/>
			</div>
		)
	}
	<button class="auth-submit" type="submit">
		{submitLabel}
	</button>
	<div class="auth-links">
		{mode === 'signin' && <a href="/reset-password/">Forgot password?</a>}
		{mode === 'signin' && <a href="/signup/">Create an account</a>}
		{mode === 'signup' && <a href="/signin/">Already have an account? Sign in</a>}
		{mode === 'reset' && <a href="/signin/">Back to sign in</a>}
	</div>
</form>

<script>
	document.querySelectorAll('form[data-auth-form]').forEach((form) => {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
		});
	});
</script>

<style>
	.auth-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.auth-field {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.auth-field label {
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}

	.auth-field input {
		width: 100%;
		padding: 0.625rem 0.875rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text);
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
	}

	.auth-field input:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 1px;
		border-color: var(--sl-color-text-accent);
	}

	.auth-submit {
		padding: 0.625rem 1.125rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		background: var(--sl-color-text-accent);
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 0.5rem;
		color: var(--sl-color-black);
		cursor: pointer;
	}

	.auth-submit:hover {
		filter: brightness(1.1);
	}

	.auth-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: center;
		font-size: var(--sl-text-sm);
	}

	.auth-links a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	.auth-links a:hover {
		text-decoration: underline;
	}
</style>
