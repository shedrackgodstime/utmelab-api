---
// Six-box OTP entry. Visual only — no backend wired, submit intercepted.
// Auto-advances, backspace navigates back, paste splits across boxes.
---

<form class="otp-form" data-otp-form>
	<div class="otp-boxes" role="group" aria-label="Six-digit verification code">
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" required />
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 2" required />
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 3" required />
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 4" required />
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 5" required />
		<input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" aria-label="Digit 6" required />
	</div>
	<button class="otp-submit" type="submit">Verify email</button>
	<div class="otp-links">
		<a href="/signup/">Didn't get a code? Resend</a>
	</div>
</form>

<script>
	const form = document.querySelector('form[data-otp-form]');
	const boxes = [...(form?.querySelectorAll('input') ?? [])];
	boxes.forEach((box, i) => {
		box.addEventListener('input', () => {
			box.value = box.value.replace(/\D/g, '').slice(-1);
			if (box.value && i < boxes.length - 1) boxes[i + 1]?.focus();
		});
		box.addEventListener('keydown', (e) => {
			if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1]?.focus();
		});
		box.addEventListener('paste', (e) => {
			e.preventDefault();
			const digits = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
			digits.split('').forEach((d, j) => {
				if (boxes[i + j]) boxes[i + j].value = d;
			});
			boxes[Math.min(i + digits.length, boxes.length - 1)]?.focus();
		});
	});
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
	});
</script>

<style>
	.otp-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.otp-boxes {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.otp-boxes input {
		width: 100%;
		aspect-ratio: 1;
		min-width: 0;
		text-align: center;
		font: inherit;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sl-color-text);
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		caret-color: var(--sl-color-text-accent);
	}

	.otp-boxes input:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 1px;
		border-color: var(--sl-color-text-accent);
	}

	.otp-submit {
		padding: 0.625rem 1.125rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		background: var(--sl-color-text-accent);
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 0.5rem;
		color: var(--sl-color-black);
		cursor: pointer;
	}

	.otp-submit:hover {
		filter: brightness(1.1);
	}

	.otp-links {
		text-align: center;
		font-size: var(--sl-text-sm);
	}

	.otp-links a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	.otp-links a:hover {
		text-decoration: underline;
	}
</style>
